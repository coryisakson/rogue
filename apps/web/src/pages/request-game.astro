---
import Base from '../layouts/Base.astro';
import { RateLimiter, parseDetails, parseGameRequest, parsePick, sameOrigin, type GameMatch } from '@rogue/core';
import { submitRequest } from '../lib/add-game';
import { submitDetails, submitPick } from '../lib/intake';
import { searchEnabled, searchGameMatches } from '../lib/search';
import { ensureMigrated, getPool } from '../lib/services';
import { Badge } from '../components/ui/badge';
import { Button } from '../components/ui/button';
import { Card, CardContent, CardHeader, CardTitle } from '../components/ui/card';
import { Input } from '../components/ui/input';
import { Textarea } from '../components/ui/textarea';
// Per user: each submission or search triggers outbound traffic.
const g = globalThis as Record<string, unknown>;
const limiter = (g['__rogueReqLimit'] ??= new RateLimiter(5, 3_600_000)) as RateLimiter;
const searchLimiter = (g['__rogueSearchLimit'] ??= new RateLimiter(20, 3_600_000)) as RateLimiter;
const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?next=/request-game');
let error: string | null = null; let sent: number | null = null;
const v: Record<string, string> = {};
let matches: GameMatch[] | null = null;
const q = (Astro.url.searchParams.get('q') ?? '').replace(/\s+/g, ' ').trim().slice(0, 80);
const manualLink = Astro.url.searchParams.get('mode') === 'link';
const searchOn = searchEnabled();
await ensureMigrated();
if (Astro.request.method === 'POST') {
  const h = Astro.request.headers;
  if (!sameOrigin(h.get('origin'), h.get('referer'), h.get('x-forwarded-host') ?? h.get('host'))) return new Response('Bad origin', { status: 403 });
  const form = Object.fromEntries((await Astro.request.formData()).entries());
  for (const k of Object.keys(form)) v[k] = String(form[k]);
  const action = String(form['action'] ?? 'link');
  if (!limiter.allow(String(user.id))) error = 'Too many requests this hour. Please try again later.';
  else if (action === 'pick') {
    const m = parsePick(form);
    if (!m) error = 'That choice was not valid. Search again.';
    else { const r = await submitPick(user.id, m); if ('error' in r) error = r.error; else sent = r.id; }
  } else if (action === 'details') {
    const d = parseDetails(form['details']);
    if (!d.ok) error = d.error;
    else { const r = await submitDetails(user.id, d.text); if ('error' in r) error = r.error; else sent = r.id; }
  } else {
    const p = parseGameRequest(form);
    if (!p.ok) error = p.error;
    else { const r = await submitRequest(user.id, p.value); if ('error' in r) error = r.error; else sent = r.id; }
  }
} else if (q.length >= 2 && searchOn) {
  if (!searchLimiter.allow(String(user.id))) error = 'Too many searches this hour.';
  else {
    try { matches = await searchGameMatches(q); }
    catch { error = 'Search is not answering right now. Describe the game below instead.'; matches = []; }
  }
}
const mine = (await getPool()!.query('SELECT id, name, status, reject_reason, progress, stage, created_at FROM game_requests WHERE user_id=$1 ORDER BY id DESC LIMIT 10', [user.id])).rows;
const label: Record<string, string> = { submitted: 'being checked', queued: 'in the queue', manual: 'being researched by an admin', checked: 'waiting for an admin', approved: 'approved', rejected: 'not accepted' };
---
<Base title="Request a game">
  <main id="main">
    <h1>Request a game</h1>
    <Card className="max-w-[38rem] text-base"><CardContent>
      {sent && <p class="mt-0"><Badge variant="success">received</Badge> Request #{sent} is in. Status below.</p>}
      {error && <p class="mt-0"><Badge variant="danger">note</Badge> {error}</p>}
      {manualLink ? (
        <>
          <p class="mt-0">Know the <b>publisher's own</b> rulebook link (preferred; other rules sources are allowed at lower weight)? Paste it. Automatic checks look at robots.txt and opt-out signals, then an admin decides. Nothing is fetched before approval.</p>
          <form method="post" class="grid gap-2.5">
            <input type="hidden" name="action" value="link" />
            <label class="grid gap-1">Game title <Input name="name" defaultValue={v['name'] ?? ''} required maxLength={80} /></label>
            <label class="grid gap-1">Publisher <Input name="publisher" defaultValue={v['publisher'] ?? ''} required maxLength={80} /></label>
            <label class="grid gap-1">Year (optional) <Input name="year" defaultValue={v['year'] ?? ''} inputMode="numeric" maxLength={4} className="w-28" /></label>
            <label class="grid gap-1">Rulebook language <Input name="language" defaultValue={v['language'] ?? 'en'} maxLength={8} className="w-28" /></label>
            <label class="grid gap-1">Link to the rulebook (https) <Input name="rulebookUrl" defaultValue={v['rulebookUrl'] ?? ''} maxLength={400} type="url" /></label>
            <label class="grid gap-1">No rulebook, only a rules wiki? Its start page (https) <Input name="wikiUrl" defaultValue={v['wikiUrl'] ?? ''} maxLength={400} type="url" /></label>
            <label class="grid gap-1">Publisher page where you found it (optional) <Input name="foundOn" defaultValue={v['foundOn'] ?? ''} maxLength={400} type="url" /></label>
            <p class="mb-0 flex flex-wrap items-center gap-3"><Button type="submit">Send request</Button> <a href="/request-game">Back to search</a></p>
          </form>
        </>
      ) : (
        <>
          {searchOn ? (
            <>
              <p class="mt-0">Type the name of a game and pick it from the list. An admin approves it, then Rogue finds the publisher's rules and builds the game page. Answers always cite the rulebook; we never host it.</p>
              <form method="get" class="flex gap-2"><Input name="q" defaultValue={q} aria-label="Game name" placeholder="Game name" required minLength={2} maxLength={80} className="flex-1" /><Button type="submit">Search</Button></form>
              {matches && matches.length > 0 && (
                <ul class="mt-4 mb-0 list-none p-0">
                  {matches.map((m) => (
                    <li class="border-t border-border py-1.5">
                      <form method="post" class="flex flex-wrap items-center gap-2.5">
                        <input type="hidden" name="action" value="pick" /><input type="hidden" name="bggId" value={m.bggId} /><input type="hidden" name="title" value={m.title} /><input type="hidden" name="year" value={m.year ?? ''} />
                        <span class="flex-1"><b>{m.title}</b>{m.year && <> ({m.year})</>} · <a href={m.url} rel="noopener nofollow" target="_blank">BoardGameGeek</a></span>
                        <Button type="submit" variant="secondary">This one</Button>
                      </form>
                    </li>
                  ))}
                </ul>
              )}
              {matches && matches.length === 0 && !error && <p>No match found for “{q}”.</p>}
            </>
          ) : (
            <p class="mt-0">Automatic game search is not switched on here. Describe the game and an admin will research it.</p>
          )}
          {(!searchOn || matches !== null || Astro.request.method === 'POST') && (
            <details open={!searchOn || (matches !== null && matches.length === 0)} class="mt-4">
              <summary>{searchOn ? "Can't find it? Describe the game" : 'Describe the game'}</summary>
              <form method="post" class="mt-2 grid gap-2.5">
                <input type="hidden" name="action" value="details" />
                <label class="grid gap-1">Give as much detail as you can: title, publisher, year, edition, language, where you saw it, links.
                  <Textarea name="details" rows={5} required minLength={10} maxLength={1200} defaultValue={v['details'] ?? q} className="min-h-32" /></label>
                <p class="m-0"><Button type="submit">Send description</Button></p>
              </form>
            </details>
          )}
          <p class="mb-0"><small>Already have the publisher's rulebook link? <a href="/request-game?mode=link">Paste it instead</a>.</small></p>
        </>
      )}
    </CardContent></Card>
    {mine.length > 0 && (
      <Card className="mt-4 max-w-[38rem] text-base">
        <CardHeader><CardTitle><h2 class="m-0 text-lg">Your requests</h2></CardTitle></CardHeader>
        <CardContent>
          <ul class="my-0">{mine.map((r) => <li>#{r.id} {r.name}: <b>{label[r.status]}</b>{r.reject_reason && <> ({r.reject_reason})</>}{(r.progress || r.stage) && <> · <small>{r.progress ?? r.stage}</small></>}</li>)}</ul>
        </CardContent>
      </Card>
    )}
  </main>
</Base>
