---
import Base from '../../layouts/Base.astro';
import { MCP_MAX_BODY_BYTES, MODERN_PROTOCOL_VERSIONS, LEGACY_PROTOCOL_VERSIONS, publicTools, t, userTools, type McpUserApi } from '@rogue/core';
import { MCP_LIMITS, publicKb, publicOrigin } from '../../lib/mcp';
import { oauthEnabled } from '../../lib/oauth';
import { Badge } from '../../components/ui/badge';
import { Card, CardContent } from '../../components/ui/card';
import { Table, TableBody, TableCaption, TableCell, TableHead, TableHeader, TableRow } from '../../components/ui/table';
const L = Astro.locals.locale;
const origin = publicOrigin(Astro.request);
const endpoint = `${origin}/mcp`;
// Tool metadata only (names, titles, descriptions): building the list runs no query.
const oauth = oauthEnabled();
// Signed-in tools (ADR 0004) are listed only when OAuth is on. Their handlers never run here, so the API is a stub.
const noApi = {} as McpUserApi;
const tools = [...publicTools(publicKb(origin)), ...(oauth ? userTools(noApi) : [])];
const versions = [...MODERN_PROTOCOL_VERSIONS, ...LEGACY_PROTOCOL_VERSIONS].join(', ');
const claudeCode = `claude mcp add --transport http rogue ${endpoint}`;
const genericJson = JSON.stringify({ mcpServers: { rogue: { type: 'http', url: endpoint } } }, null, 2);
const inspector = 'npx @modelcontextprotocol/inspector';
// Each section is a card with role=region (what <section> was); its h2 is the region's accessible name.
const section = 'mt-4 text-base';
---
<Base title={t(L, 'mcp.title')}>
  <main id="main" class="mcp-doc">
    <h1>{t(L, 'mcp.title')}</h1>
    <p>{t(L, 'mcp.intro')}</p>

    <Card className={section} role="region" aria-labelledby="mcp-endpoint"><CardContent>
      <h2 id="mcp-endpoint" class="mt-0">{t(L, 'mcp.endpoint')}</h2>
      <pre><code>{endpoint}</code></pre>
      <p>{t(L, 'mcp.endpointNote', { versions })}</p>
      <p class="mb-0"><small>{t(L, 'mcp.card')} <a href="/mcp/server-card">{`${origin}/mcp/server-card`}</a></small></p>
    </CardContent></Card>

    <Card className={section} role="region" aria-labelledby="mcp-connect"><CardContent>
      <h2 id="mcp-connect" class="mt-0">{t(L, 'mcp.connect')}</h2>
      <h3>Claude Code</h3>
      <pre><code>{claudeCode}</code></pre>
      <h3>Claude, ChatGPT</h3>
      <p>{t(L, 'mcp.connectors')}</p>
      <h3>JSON</h3>
      <p>{t(L, 'mcp.json')}</p>
      <pre><code>{genericJson}</code></pre>
      <h3>MCP Inspector</h3>
      <pre><code>{inspector}</code></pre>
      <p class="mb-0">{t(L, 'mcp.inspector')}</p>
    </CardContent></Card>

    <Card className={section} role="region" aria-labelledby="mcp-tools"><CardContent>
      <h2 id="mcp-tools" class="mt-0">{t(L, 'mcp.tools')}</h2>
      <p><small>{t(L, 'mcp.toolsNote')}</small></p>
      <Table className="text-base">
        <TableCaption className="mt-0 mb-2 caption-top text-left">{t(L, 'mcp.toolsCaption', { n: tools.length })}</TableCaption>
        <TableHeader><TableRow><TableHead scope="col">{t(L, 'mcp.toolName')}</TableHead><TableHead scope="col">{t(L, 'mcp.toolWhat')}</TableHead></TableRow></TableHeader>
        <TableBody>
          {tools.map((tool) => (
            <TableRow><TableHead scope="row" className="h-auto py-2 align-top font-normal"><code>{tool.name}</code>{tool.costly && <> <Badge variant="secondary">{t(L, 'mcp.aiTool')}</Badge></>}{tool.scopes?.length ? <> <Badge variant="outline">{t(L, 'mcp.needsSignIn')}</Badge></> : null}</TableHead><TableCell className="align-top whitespace-normal" lang="en">{tool.description}</TableCell></TableRow>
          ))}
        </TableBody>
      </Table>
    </CardContent></Card>

    <Card className={section} role="region" aria-labelledby="mcp-limits"><CardContent>
      <h2 id="mcp-limits" class="mt-0">{t(L, 'mcp.limits')}</h2>
      <p class="mb-0">{t(L, 'mcp.limitsBody', { general: MCP_LIMITS.general, model: MCP_LIMITS.model, kb: MCP_MAX_BODY_BYTES / 1024 })}</p>
    </CardContent></Card>

    <Card className={section} role="region" aria-labelledby="mcp-cited"><CardContent>
      <h2 id="mcp-cited" class="mt-0">{t(L, 'mcp.cited')}</h2>
      <p>{t(L, 'mcp.citedBody')}</p>
      {!oauth && <p class="mb-0">{t(L, 'mcp.later')}</p>}
    </CardContent></Card>

    {oauth && (
      <Card className={section} role="region" aria-labelledby="mcp-signed-in"><CardContent>
        <h2 id="mcp-signed-in" class="mt-0">{t(L, 'mcp.signedIn')}</h2>
        <p>{t(L, 'mcp.signedInBody')}</p>
        <p class="mb-0">{t(L, 'mcp.signedInManage')} <a href="/oauth/apps">{t(L, 'oauth.appsTitle')}</a></p>
      </CardContent></Card>
    )}
  </main>
  <style>
    .mcp-doc { max-width: 60rem; }
    .mcp-doc pre { background: var(--muted); color: var(--foreground); border: 1px solid var(--border); border-radius: var(--radius); padding: .6rem .8rem; overflow-x: auto; white-space: pre; }
    .mcp-doc h3 { margin: .8rem 0 .3rem; font-size: 1rem; }
  </style>
</Base>
