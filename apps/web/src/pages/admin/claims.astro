---
import Admin from '../../layouts/Admin.astro';
import { reviewQueue } from '../../lib/claim-review';
import { Badge } from '../../components/ui/badge';
import { Button } from '../../components/ui/button';
import { Card, CardContent } from '../../components/ui/card';
import { Input } from '../../components/ui/input';
import { Textarea } from '../../components/ui/textarea';
const game = Astro.url.searchParams.get('game');
const page = Math.max(0, Number(Astro.url.searchParams.get('page') ?? 0) || 0);
const PER = 15;
const { total, items } = await reviewQueue(game, PER, page * PER);
const here = Astro.url.pathname + Astro.url.search;
const pages = Math.ceil(total / PER);
const link = (p: number) => `/admin/claims?${new URLSearchParams({ ...(game ? { game } : {}), page: String(p) })}`;
---
<Admin title="Claim review">
  <p>{total} exception{total === 1 ? '' : 's'} need a human (claims flagged needs_review by an agent or a source change, or rated low by users). Everything else is checked by agents and not shown here. <b>Approve</b> marks it human-reviewed; <b>Edit</b> fixes the wording (citation kept) and approves; <b>Reject</b> hides it with a reason. Check the quote against the cited page.</p>
  {items.length === 0 && <Card className="text-base"><CardContent>Nothing to review.</CardContent></Card>}
  <div class="grid gap-3">
    {items.map((c) => (
      <Card className="text-base"><CardContent>
        <div class="flex flex-wrap items-center gap-1"><Badge variant="secondary">{c.game}</Badge> <Badge variant="secondary">{c.topic.replace('_', ' ')}</Badge>{c.player_count && <Badge variant="warning">{c.player_count} players</Badge>} <small>#{c.id} · {c.created_by}</small></div>
        <form method="post" action="/admin/review" class="mt-2">
          <input type="hidden" name="claim" value={c.id} /><input type="hidden" name="next" value={here} />
          <Textarea name="body" aria-label="Claim text" rows={3} maxLength={600} className="bg-background text-base md:text-base" defaultValue={c.body} />
          <p class="my-1.5"><small>Source: <a href={c.source_url}>{c.source_title}</a> · {c.locator}</small></p>
          {c.quote && <blockquote class="mt-1 mb-2 text-sm text-muted-foreground">“{c.quote}”</blockquote>}
          <div class="flex flex-wrap items-center gap-2">
            <Button type="submit" name="action" value="approve">Approve</Button>
            <Button type="submit" variant="secondary" name="action" value="edit">Save edit + approve</Button>
            <Input name="reason" aria-label="Reject reason" placeholder="Reject reason" className="w-56 bg-background" />
            <Button type="submit" variant="destructive" name="action" value="reject">Reject</Button>
          </div>
        </form>
      </CardContent></Card>
    ))}
  </div>
  <p>{page > 0 && <a href={link(page - 1)}>← Newer</a>} {page + 1 < pages && <a href={link(page + 1)}>More →</a>}</p>
</Admin>
