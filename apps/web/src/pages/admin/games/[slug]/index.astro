---
import Admin from '../../../../layouts/Admin.astro';
import { mergeTimeline, pageSourceCounts, summarizeQuality, type TimelineEvent } from '@rogue/core';
import GameManageBar from '../../../../components/GameManageBar.astro';
import { isAdmin } from '../../../../lib/admin';
import { HUB_AUDIT_ACTIONS, hubAudit, hubGame, hubPageScores, hubRequests, hubSources, type HubAudit } from '../../../../lib/admin-games';
import { factsCount } from '../../../../lib/game-sources';
import { Badge } from '../../../../components/ui/badge';
import { Card, CardContent, CardHeader, CardTitle } from '../../../../components/ui/card';
import { Table, TableBody, TableCaption, TableCell, TableHead, TableHeader, TableRow } from '../../../../components/ui/table';
// Read-only overview of one game: text quality first, then history, request, sources, extracts and audit log. Every change
// (add, replace, re-ingest, delete a source or an extract) is on the Manage subpages, so each gate exists in one place.
if (!isAdmin(Astro.locals.user)) return new Response('Not found', { status: 404 });
const slug = String(Astro.params.slug ?? '');
if (!/^[a-z0-9-]{1,80}$/.test(slug)) return new Response('Not found', { status: 404 });
const game = await hubGame(slug);
if (!game) return new Response('Not found', { status: 404 });
const [requests, sources, facts] = await Promise.all([hubRequests(slug), hubSources(slug), factsCount(slug)]);
const [audit, scores] = await Promise.all([hubAudit(slug, sources.map((s) => s.url)), hubPageScores(sources.map((s) => s.id))]);
const base = `/admin/games/${encodeURIComponent(slug)}`;
const viewer = (id: number, page?: number) => `${base}/extracts?source=${id}${page ? `&page=${page}` : ''}`;

const when = (d: Date | null) => (d ? d.toISOString().slice(0, 16).replace('T', ' ') : 'unknown');
const num = (v: unknown) => (typeof v === 'number' ? v : null);
// Audit lines carry ids, counts and URLs only (never source text), so they can be shown as they are.
function auditText(a: HubAudit): string {
  const d = a.detail;
  if (a.action === 'fetched') return `Fetched ${a.url ?? ''}${num(d['pages']) !== null ? ` (${d['pages']} pages)` : ''}`;
  if (a.action === 'extract_empty') return `Extraction empty, nothing stored: ${a.url ?? ''}`;
  if (a.action === 'extract_failed') return `Extraction failed: ${a.url ?? ''}${typeof d['error'] === 'string' ? ` (${d['error'].slice(0, 160)})` : ''}`;
  if (a.action === 'extract_deleted') return `Extract of source #${d['sourceId'] ?? '?'}${num(d['page']) !== null ? ` (page ${d['page']} only)` : ''} deleted by ${a.actor}: ${num(d['chunks']) ?? '?'} chunks${typeof d['reason'] === 'string' ? `, reason: ${d['reason']}` : ''}`;
  if (a.action === 'source_captured') return `${d['recapture'] ? 'Re-captured' : 'Captured'} ${a.url ?? ''} in the browser by ${a.actor}: ${num(d['chars']) ?? '?'} characters, ${num(d['pages']) ?? '?'} pages`;
  if (a.action === 'source_deleted') return `Source #${d['sourceId'] ?? '?'} deleted by ${a.actor}: ${a.url ?? ''}${typeof d['reason'] === 'string' ? `, reason: ${d['reason']}` : ''}`;
  if (a.action === 'takedown') return `Takedown #${d['requestId'] ?? '?'}: ${num(d['sources']) ?? '?'} sources, ${num(d['claims']) ?? '?'} facts`;
  return a.action;
}
const timeline = mergeTimeline(
  [{ at: game.createdAt, kind: 'game', text: 'Game added to Rogue', key: 'g' }],
  requests.flatMap((r): TimelineEvent[] => [
    { at: r.createdAt, kind: 'request', text: `Request #${r.id} by ${r.requester ?? 'deleted user'}`, key: `r${r.id}` },
    ...(r.decidedAt ? [{ at: r.decidedAt, kind: 'request', text: `Request #${r.id} ${r.status} by ${r.decider ?? 'an admin'}${r.rejectReason ? `: ${r.rejectReason}` : ''}`, key: `r${r.id}d` }] : []),
  ]),
  audit.map((a) => ({ at: a.at, kind: a.action, text: auditText(a), key: `a${String(a.id).padStart(12, '0')}` })),
);
type Status = 'success' | 'warning' | 'danger' | 'secondary';
const availBadge: Record<string, Status> = { available: 'success', changed: 'warning', unavailable: 'danger' };
const verdictBadge: Record<string, Status> = { pass: 'success', problem: 'warning', blocked: 'danger', clear: 'success', restricted: 'danger' };
const statusBadge: Record<string, Status> = { approved: 'success', rejected: 'danger' };
const extractProblems = (url: string) => audit.filter((a) => a.url === url && (a.action === 'extract_empty' || a.action === 'extract_failed'));
// Text quality per source: page_quality scores, how the pages were read, extraction problems and chunks still waiting for an embedding.
const quality = sources.map((s) => ({ s, q: summarizeQuality(scores.get(s.id) ?? [], 3), via: pageSourceCounts(s.fetchedDetail), problems: extractProblems(s.url), unembedded: s.chunks - s.embedded }));
const anyQuality = quality.some((x) => x.q.pages > 0 || x.problems.length > 0 || x.s.chunks > 0);
---
<Admin title={game.name}>
  <GameManageBar slug={slug} current="overview" />
  <p><small>{game.publisher ?? 'publisher unknown'} · {game.year ?? 'year ?'} · slug <code>{slug}</code>{game.bggId && <> · <a href={`https://boardgamegeek.com/boardgame/${game.bggId}`} rel="noopener nofollow">BGG {game.bggId}</a></>} · {sources.length} sources · {facts} published facts</small></p>

  <Card className="mb-3 text-base">
    <CardHeader><CardTitle><h2 class="m-0 text-lg">Text quality</h2></CardTitle></CardHeader>
    <CardContent>
      {!anyQuality && <p class="m-0" role="status">No quality data yet: no source of this game has been extracted and scored. Scoring runs when a source is indexed.</p>}
      {anyQuality && (
        <ul class="m-0 list-none p-0">
          {quality.map(({ s, q, via, problems, unembedded }) => (
            <li class="border-t border-border py-1.5">
              <b>#{s.id} {s.title ?? s.url}</b>
              {q.avg !== null && <> <Badge variant={q.low > 0 ? 'warning' : 'success'}>average score {q.avg.toFixed(2)}</Badge></>}
              {problems.map((a) => <> <Badge variant="danger">{a.action}</Badge></>)}
              {unembedded > 0 && <> <Badge variant="warning">{unembedded} chunks without embeddings</Badge></>}
              <div><small>
                {q.pages > 0 ? `${q.pages} scored pages · ${q.low} low-scoring` : 'not scored yet'}
                {' · '}{via ? `${via.textLayer} text-layer, ${via.ocr} OCR pages` : 'text layer vs OCR unknown'}
                {' · '}{s.hasText ? `${s.chunks} chunks (${s.embedded} embedded)` : 'not extracted'}
              </small></div>
              {q.worst.length > 0 && s.hasText && (
                <div><small>Worst pages: {q.worst.map((p, i) => <>{i > 0 && ', '}<a href={viewer(s.id, p.page)}>page {p.page}</a> ({p.verdict}, {p.score.toFixed(2)})</>)}</small></div>
              )}
            </li>
          ))}
        </ul>
      )}
      <p class="mb-0"><small>Low-scoring means the scorer did not call the page ok (suspect, garbled or empty). Fix or delete bad extracts on <a href={`${base}/extracts`}>Manage extracts</a>.</small></p>
    </CardContent>
  </Card>

  <Card className="mb-3 text-base">
    <CardHeader><CardTitle><h2 class="m-0 text-lg">History</h2></CardTitle></CardHeader>
    <CardContent>
      <ol class="m-0 list-none p-0">
        {timeline.map((e) => <li class="border-t border-border py-1"><small>{when(e.at)}</small> <Badge variant="secondary">{e.kind}</Badge> {e.text}</li>)}
      </ol>
    </CardContent>
  </Card>

  <Card className="mb-3 text-base">
    <CardHeader><CardTitle><h2 class="m-0 text-lg">Request</h2></CardTitle></CardHeader>
    <CardContent>
      {requests.length === 0 && <p class="m-0">No request: this game was seeded or added by an admin.</p>}
      {requests.map((r) => (
        <div class="border-t border-border py-1.5">
          <b>#{r.id} {r.name}</b> <Badge variant={statusBadge[r.status] ?? 'secondary'}>{r.status}</Badge>
          {r.rightsVerdict && <> <Badge variant={verdictBadge[r.rightsVerdict] ?? 'secondary'}>rights: {r.rightsVerdict}</Badge></>}
          {r.termsVerdict && <> <Badge variant={verdictBadge[r.termsVerdict] ?? 'warning'}>terms: {r.termsVerdict}</Badge></>}
          <div><small>Asked by {r.requester ?? 'deleted user'} on {when(r.createdAt)} ({r.mode}) · decided {r.decidedAt ? `${when(r.decidedAt)} by ${r.decider ?? 'an admin'}` : 'not yet'}</small></div>
          {r.rulebookUrl && <div><small>Rulebook link: <a href={r.rulebookUrl} rel="noopener nofollow">{r.rulebookUrl}</a></small></div>}
          {r.termsUrl && <div><small>Terms read: <a href={r.termsUrl} rel="noopener nofollow">{r.termsUrl}</a></small></div>}
          {r.rejectReason && <div><small>Rejected: {r.rejectReason}</small></div>}
          {(r.progress || r.stage) && <div><small>{r.progress ? `Pipeline: ${r.progress}` : `Stage: ${r.stage}`}</small></div>}
        </div>
      ))}
    </CardContent>
  </Card>

  <Card className="mb-3 text-base">
    <CardContent>
      <Table>
        <TableCaption className="mt-0 mb-2 caption-top text-left"><h2 class="m-0 text-lg">Sources</h2></TableCaption>
        <TableHeader><TableRow>
          <TableHead scope="col">Source</TableHead><TableHead scope="col">Authority</TableHead><TableHead scope="col">Lang</TableHead><TableHead scope="col">Availability</TableHead>
          <TableHead scope="col">Fetched</TableHead><TableHead scope="col">Pages</TableHead><TableHead scope="col">Chunks (embedded)</TableHead>
        </TableRow></TableHeader>
        <TableBody>
          {sources.length === 0 && <TableRow><TableCell colSpan={7}>No sources.</TableCell></TableRow>}
          {sources.map((s) => (
            <TableRow>
              <TableCell className="whitespace-normal">#{s.id} <a href={s.url} rel="noopener nofollow">{s.title ?? s.url}</a><br /><small>{s.kind} · {s.edition}{s.runtime && ' · admin-added'}</small>{s.capture && <><br /><Badge variant="warning">{s.capture}</Badge></>}</TableCell>
              <TableCell>{s.authority}</TableCell>
              <TableCell>{s.language ?? '?'}</TableCell>
              <TableCell><Badge variant={availBadge[s.availability] ?? 'secondary'}>{s.availability}</Badge></TableCell>
              <TableCell>{s.fetchedAt ?? 'never'}</TableCell>
              <TableCell>{s.indexedPages} / {s.pageCount ?? '?'}</TableCell>
              <TableCell>{s.chunks} ({s.embedded})</TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
      <small>Add, replace, re-ingest or delete a source on <a href={`${base}/sources`}>Manage sources</a>.</small>
    </CardContent>
  </Card>

  <Card className="mb-3 text-base">
    <CardHeader><CardTitle><h2 class="m-0 text-lg">Extracts</h2></CardTitle></CardHeader>
    <CardContent>
      {sources.length === 0 && <p class="m-0">Nothing extracted.</p>}
      <ul class="m-0 list-none p-0">
        {sources.map((s) => (
          <li class="border-t border-border py-1.5">
            #{s.id} {s.hasText ? <a href={viewer(s.id)}>{s.title ?? s.url}</a> : (s.title ?? s.url)}
            <div><small>{s.pageCount ?? '?'} pages · {s.indexedPages} indexed · {s.extract}{!s.hasText && ' · not extracted'}</small></div>
            {extractProblems(s.url).map((a) => <div><small><Badge variant="warning">{a.action}</Badge> {when(a.at)}</small></div>)}
          </li>
        ))}
      </ul>
      <p class="mb-0"><small>Read page by page, download or delete an extract on <a href={`${base}/extracts`}>Manage extracts</a>.</small></p>
    </CardContent>
  </Card>

  <Card className="text-base">
    <CardHeader><CardTitle><h2 class="m-0 text-lg">Audit log</h2></CardTitle></CardHeader>
    <CardContent>
      <p class="mt-0"><small>Entries {HUB_AUDIT_ACTIONS.join(', ')} for this game's links, newest first.</small></p>
      {audit.length === 0 && <p class="m-0">No entries.</p>}
      <ul class="m-0 list-none p-0">
        {audit.map((a) => <li class="border-t border-border py-1"><small>{when(a.at)} · {a.actor}</small> <Badge variant="secondary">{a.action}</Badge> {auditText(a)}</li>)}
      </ul>
    </CardContent>
  </Card>
</Admin>
