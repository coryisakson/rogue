---
import Admin from '../../../layouts/Admin.astro';
import { lastActivity, normalizeGameQuery, recentGames, searchGames } from '@rogue/core';
import IngestedGameSearch from '../../../components/IngestedGameSearch.astro';
import { isAdmin } from '../../../lib/admin';
import { ingestedGames } from '../../../lib/admin-games';
import { Card, CardContent } from '../../../components/ui/card';
import { buttonVariants } from '../../../components/ui/button';
// Read-only overview. Middleware already limits /admin to signed-in admins; repeated here like the other admin pages.
if (!isAdmin(Astro.locals.user)) return new Response('Not found', { status: 404 });
const games = await ingestedGames();
const q = normalizeGameQuery(Astro.url.searchParams.get('q'));
const results = q ? searchGames(games, q) : null;
const recent = recentGames(games, 8);
const when = (d: Date | null) => (d ? d.toISOString().slice(0, 10) : 'no date');
---
<Admin title="Games">
  <p>One place per game: the request, its sources, the extracted text and what the audit log says about them. Search covers games already in Rogue (at least one source). Pending requests stay on <a href="/admin/requests">Game requests</a> until they are accepted.</p>
  <IngestedGameSearch action="/admin/games" q={q} results={results} />
  <h2 class="text-lg">Recently added or updated</h2>
  {recent.length === 0 && <Card className="text-base"><CardContent>No game has a source yet.</CardContent></Card>}
  <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
    {recent.map((g) => (
      <li><a data-slot="button" class={buttonVariants({ variant: 'outline' })} href={`/admin/games/${encodeURIComponent(g.slug)}`}>{g.name} <small>{when(lastActivity(g))}</small></a></li>
    ))}
  </ul>
  <p><small>{games.length} games in Rogue.</small></p>
</Admin>
