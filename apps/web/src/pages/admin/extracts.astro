---
// Old URL, kept for deep links: the extract viewer moved to /admin/games/<slug>/extracts (Cory 2026-10-18).
// ?game=<slug>, or ?source=<id> (its game is looked up; ?page and ?format=md are kept); otherwise the games list.
import { isAdmin } from '../../lib/admin';
import { sourceGameSlug } from '../../lib/admin-games';
if (!isAdmin(Astro.locals.user)) return new Response('Not found', { status: 404 });
const sp = Astro.url.searchParams;
const id = (k: string) => (/^[1-9]\d{0,15}$/.test(sp.get(k) ?? '') ? sp.get(k)! : null);
const source = id('source');
const game = source ? await sourceGameSlug(Number(source)) : sp.get('game');
if (!game || !/^[a-z0-9-]{1,80}$/.test(game)) return Astro.redirect('/admin/games', 302);
const keep = new URLSearchParams();
if (source) {
  keep.set('source', source);
  if (id('page')) keep.set('page', id('page')!);
  if (sp.get('format') === 'md') keep.set('format', 'md');
}
return Astro.redirect(`/admin/games/${encodeURIComponent(game)}/extracts${keep.size ? `?${keep}` : ''}`, 302);
---
