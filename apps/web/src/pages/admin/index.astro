---
import Admin from '../../layouts/Admin.astro';
import { getPool, ensureMigrated } from '../../lib/services';
import { getBackupState } from '../../lib/backup-runner';
import { readApprovals, readReviewLog } from '../../lib/admin';
import { VERSION } from '../../lib/version';
await ensureMigrated();
const pool = getPool();
const n = async (sql: string) => pool ? Number((await pool.query(sql)).rows[0].n) : 0;
const stats = { claims: await n("SELECT count(*) n FROM claims WHERE status='published'"), users: await n('SELECT count(*) n FROM users'), ratings: await n('SELECT count(*) n FROM claim_ratings'), violations: await n('SELECT count(*) n FROM provenance_violations') };
const b = getBackupState();
const openApprovals = readApprovals().filter((a) => a.status === 'OPEN').length;
const open = readReviewLog().filter((r) => r.status === 'open').length;
---
<Admin title="Overview">
  <div class="grid">
    <div class="card"><b>Version</b><br />{VERSION}</div>
    <div class="card"><b>Published facts</b><br />{stats.claims}</div>
    <div class="card"><b>Users / ratings</b><br />{stats.users} / {stats.ratings}</div>
    <div class="card"><b>Provenance</b><br />{stats.violations === 0 ? <span class="pill ok">0 violations</span> : <span class="pill bad">{stats.violations} violations</span>}</div>
    <div class="card"><b>Last backup (since restart)</b><br />{b.lastBackup ? <span class={`pill ${b.lastBackup.ok ? 'ok' : 'bad'}`}>{b.lastBackup.ok ? 'ok' : 'failed'}</span> : 'none yet'} <a href="/admin/backups">details</a></div>
    <div class="card"><b>Open approvals</b><br />{openApprovals} <a href="/admin/approvals">view</a></div>
    <div class="card"><b>Open review items</b><br />{open} <a href="/admin/review-log">view</a></div>
  </div>
</Admin>
