---
import Admin from '../../layouts/Admin.astro';
import { getPool, ensureMigrated } from '../../lib/services';
import { sourceWeight } from '@rogue/core';
import { agentsEnabled } from '../../lib/agent-jobs';
import { Badge } from '../../components/ui/badge';
import { Button } from '../../components/ui/button';
import { Card, CardContent } from '../../components/ui/card';
await ensureMigrated();
const pool = getPool();
const q = async (sql: string) => (pool ? (await pool.query(sql)).rows : []);
const JOB_LABEL: Record<string, string> = { quality_curate: 'Quality Curator', scout_variants: 'Scout (text versions)', librarian_draft: 'Librarian', terms_judge: 'Terms Agent' };
const sources = await q(`SELECT s.id, s.title, s.content_type, s.authority, (SELECT d.kind FROM documents d WHERE d.source_id=s.id LIMIT 1) kind, count(*)::int pages,
    count(*) FILTER (WHERE pq.verdict='ok')::int ok, count(*) FILTER (WHERE pq.verdict IN ('suspect','garbled'))::int weak,
    count(*) FILTER (WHERE pq.state='repaired')::int repaired, count(*) FILTER (WHERE pq.state='unusable')::int unusable,
    count(*) FILTER (WHERE pq.state='reviewed')::int reviewed, round(avg(pq.score)::numeric,2) avg
  FROM page_quality pq JOIN sources s ON s.id=pq.source_id GROUP BY s.id ORDER BY avg(pq.score)`);
const jobs = await q(`SELECT j.id, j.kind, j.status, j.summary, j.error, j.attempts, to_char(j.finished_at,'YYYY-MM-DD HH24:MI') fin,
    COALESCE(s.title, 'request #' || g.id || ': ' || g.name) title FROM agent_jobs j LEFT JOIN sources s ON s.id=j.source_id LEFT JOIN game_requests g ON g.id=j.request_id ORDER BY (j.status='needs_human') DESC, j.id DESC LIMIT 25`);
const variants = await q(`SELECT v.id, v.url, v.status, v.coverage, v.reason, v.proposed_by, s.title FROM text_variants v JOIN sources s ON s.id=v.source_id ORDER BY (v.status='needs_human') DESC, v.id DESC LIMIT 25`);
const waiting = variants.filter((v) => v.status === 'needs_human');
---
<Admin title="Text quality">
  <p>Agents curate the text that gets indexed. Pages are scored by code; the <b>Quality Curator</b> repairs or re-reads weak pages and the <b>Scout</b> looks for a text version of each PDF rulebook. You only need to act on the yellow items. Agents are {agentsEnabled() ? 'on' : 'off (ROGUE_AGENTS_URL is not set or ROGUE_AGENTS=0)'}.</p>
  <p><small>Answer quality lives in one queue: poorly rated answers and questions the assistant could not answer are on <a href="/admin/faq">FAQ ratings</a>.</small></p>

  {waiting.length > 0 && <Card className="text-base ring-2 ring-secondary"><CardContent>
    <h2 class="mt-0 text-lg">Text versions waiting for your decision ({waiting.length})</h2>
    {waiting.map((v) => (
      <form method="post" action="/admin/quality-decide" class="my-2.5">
        <b>{v.title}</b><br /><a href={v.url}>{v.url}</a><br /><small>{v.reason}</small><br />
        <input type="hidden" name="id" value={v.id} />
        <div class="mt-1.5 flex flex-wrap items-center gap-2">
          <label class="flex items-center gap-2"><input type="checkbox" name="terms" value="1" class="size-4 accent-primary" /> I read this site's terms</label>
          <Button type="submit" variant="secondary" name="action" value="approve">Use this text version</Button>
          <Button type="submit" variant="destructive" name="action" value="reject">Reject</Button>
        </div>
      </form>
    ))}
  </CardContent></Card>}

  <h2 class="text-lg">Sources</h2>
  {sources.length === 0 && <Card className="text-base"><CardContent>No scored sources yet. Scoring runs when a source is indexed.</CardContent></Card>}
  <div class="grid gap-2">
    {sources.map((s) => (
      <Card className="text-base"><CardContent>
        <b>{s.title}</b> <Badge variant="secondary">{String(s.content_type).split(';')[0]}</Badge> <Badge variant="secondary" title="Retrieval weight: rulebook highest, then publisher/author clarifications, then everything else">weight {sourceWeight(s.kind, s.authority).toFixed(2)} ({s.kind ?? 'other'}, {s.authority ?? 'other'})</Badge>
        <div><small>{s.pages} pages · average score {s.avg} · {s.ok} clean · {s.weak} weak · {s.repaired} repaired · {s.reviewed} reviewed, kept · {s.unusable} left out</small></div>
      </CardContent></Card>
    ))}
  </div>

  <h2 class="text-lg">Agent jobs</h2>
  <div class="grid gap-1.5">
    {jobs.map((j) => (
      <Card className="text-base"><CardContent>
        <Badge variant={j.status === 'needs_human' || j.status === 'failed' ? 'danger' : 'secondary'}>{j.status}</Badge> #{j.id} {JOB_LABEL[j.kind] ?? j.kind} ·{j.title} <small>{j.fin ?? ''}</small>
        {j.summary && <div><small>{j.summary}</small></div>}
        {j.error && <div><small>Error: {j.error}</small></div>}
      </CardContent></Card>
    ))}
    {jobs.length === 0 && <Card className="text-base"><CardContent>No jobs yet.</CardContent></Card>}
  </div>

  <h2 class="text-lg">Text versions found</h2>
  <div class="grid gap-1.5">
    {variants.filter((v) => v.status !== 'needs_human').map((v) => (
      <Card className="text-base"><CardContent><Badge variant={v.status === 'rejected' ? 'danger' : 'secondary'}>{v.status}</Badge> {v.title}: <a href={v.url}>{v.url}</a><br /><small>{v.reason}</small></CardContent></Card>
    ))}
  </div>
</Admin>
