---
import Admin from '../../layouts/Admin.astro';
import { lowRatedFaq } from '../../lib/faq';
import { openUnanswered } from '../../lib/unanswered';
import { helpfulLabel, improvementQueue } from '@rogue/core';
const KIND_LABEL: Record<string, string> = { refusal: 'the rulebook excerpts did not say', no_sources: 'no rulebook passage found', error: 'the assistant failed', empty: 'empty answer' };
// One improvement queue: low-rated answers and questions that got no answer, most-affected first.
const items = improvementQueue([
  ...(await lowRatedFaq()).map((f) => ({ ...f, reason: 'low_rating' as const, count: f.total })),
  ...(await openUnanswered()).map((u) => ({ ...u, reason: 'no_answer' as const, count: u.ask_count })),
]);
---
<Admin title="FAQ ratings">
  <p>{items.length} question{items.length === 1 ? '' : 's'} to improve: answers most voters found unhelpful (at least 3 votes, under 50% helpful) and questions the assistant could not answer. Well-rated questions are published in each game's FAQ automatically and need nothing from you. <b>Remove from FAQ</b> hides it publicly (reason required, logged). <b>Keep</b> means you checked it and it is fine; it will not be flagged again. For an unanswered question, <b>Resolved</b> means you fixed the cause (it comes back if it fails again); <b>Dismiss</b> means it needs nothing (not a rules question). To fix the cause, check the rulebook page cited, and improve or reject the underlying fact on the Claims page.</p>
  {items.length === 0 && <div class="card">Nothing to review.</div>}
  <div style="display:grid;gap:.8rem">
    {items.map((f) => f.reason === 'no_answer' ? (
      <div class="card">
        <span class="pill">{f.game_slug}</span> <span class="pill bad">no answer</span> <small>asked {f.ask_count}× via {f.channels.join(', ')} · last {f.last_seen.toISOString().slice(0, 16).replace('T', ' ')} · {KIND_LABEL[f.last_kind] ?? f.last_kind}</small>
        <h3 style="margin:.4rem 0">{f.question}</h3>
        <form method="post" action="/admin/faq-decide" style="margin:.5rem 0 0">
          <input type="hidden" name="kind" value="no_answer" /><input type="hidden" name="game" value={f.game_slug} /><input type="hidden" name="q" value={f.question_norm} />
          <button class="btn" name="action" value="resolve" style="border:0;background:#cdbf9b">Resolved</button>
          <button class="btn" name="action" value="dismiss" style="border:0">Dismiss</button>
        </form>
      </div>
    ) : (
      <div class="card">
        <span class="pill">{f.game_slug}</span> <span class="pill bad">{helpfulLabel(f.up, f.total)}</span>
        <h3 style="margin:.4rem 0">{f.question}</h3>
        <p style="margin:.2rem 0">{f.answer}</p>
        <small>{f.sources?.map((s) => <><a href={s.url}>p.{s.page}</a>{' '}</>)}</small>
        <form method="post" action="/admin/faq-decide" style="margin:.5rem 0 0">
          <input type="hidden" name="game" value={f.game_slug} /><input type="hidden" name="q" value={f.question_norm} />
          <button class="btn" name="action" value="keep" style="border:0;background:#cdbf9b">Keep (fine)</button>
          <input name="reason" placeholder="Reason to remove" style="padding:.4rem;border-radius:8px;border:0" />
          <button class="btn" name="action" value="hide" style="border:0;background:#b5544a">Remove from FAQ</button>
        </form>
      </div>
    ))}
  </div>
</Admin>
