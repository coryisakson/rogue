---
// Old URL, kept for deep links: source management moved to /admin/games/<slug>/sources (Cory 2026-10-18).
// ?game=<slug> keeps its delete/replace parameters; without a game, the games list. Middleware limits /admin to admins.
import { isAdmin } from '../../lib/admin';
if (!isAdmin(Astro.locals.user)) return new Response('Not found', { status: 404 });
const sp = Astro.url.searchParams;
const game = sp.get('game') ?? '';
if (!/^[a-z0-9-]{1,80}$/.test(game)) return Astro.redirect('/admin/games', 302);
const keep = new URLSearchParams([...sp].filter(([k, v]) => (k === 'delete' || k === 'replace') && /^[1-9]\d{0,15}$/.test(v)));
const hash = keep.has('delete') ? '#delete' : keep.has('replace') ? '#add' : '';
return Astro.redirect(`/admin/games/${encodeURIComponent(game)}/sources${keep.size ? `?${keep}` : ''}${hash}`, 302);
---
