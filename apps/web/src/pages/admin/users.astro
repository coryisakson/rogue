---
import Admin from '../../layouts/Admin.astro';
import { adminIds } from '../../lib/admin';
import { ensureMigrated, getPool } from '../../lib/services';
import { Card, CardContent } from '../../components/ui/card';
import { Table, TableBody, TableCaption, TableCell, TableHead, TableHeader, TableRow } from '../../components/ui/table';
await ensureMigrated();
const rows = (await getPool()!.query(`SELECT u.id, u.display_name, u.created_at, u.last_login,
  (SELECT string_agg(provider, ', ' ORDER BY created_at) FROM identities i WHERE i.user_id=u.id) providers,
  (SELECT count(*)::int FROM claim_ratings r WHERE r.user_id=u.id) ratings FROM users u ORDER BY u.id`)).rows;
const admins = adminIds();
---
<Admin title="Users">
  <Card className="py-1"><CardContent>
    <Table className="text-base">
      <TableCaption className="sr-only">Users</TableCaption>
      <TableHeader><TableRow><TableHead scope="col">ID</TableHead><TableHead scope="col">Name</TableHead><TableHead scope="col">Sign-in</TableHead><TableHead scope="col">Ratings</TableHead><TableHead scope="col">Last login</TableHead><TableHead scope="col">Role</TableHead></TableRow></TableHeader>
      <TableBody>
        {rows.map((u) => <TableRow><TableCell>{u.id}</TableCell><TableCell>{u.display_name}</TableCell><TableCell>{u.providers}</TableCell><TableCell>{u.ratings}</TableCell><TableCell>{new Date(u.last_login).toISOString().slice(0, 16)}</TableCell><TableCell>{admins.includes(Number(u.id)) ? 'admin' : ''}</TableCell></TableRow>)}
      </TableBody>
    </Table>
  </CardContent></Card>
  <p><small>Admins are set by ROGUE_ADMIN_USER_IDS or admins.json on the data volume. Users can delete their own accounts at /account.</small></p>
</Admin>
