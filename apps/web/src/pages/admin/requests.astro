---
import Admin from '../../layouts/Admin.astro';
import { sameOrigin, parseGameRequest, googleLink, adminSearchQuery, BGG_TOP10_DATE } from '@rogue/core';
import { approveGame, completeManual, editSource, queueTopGames, resumeQueue } from '../../lib/intake';
import { approveRequest, rejectRequest, runChecks } from '../../lib/add-game';
import { isAdmin } from '../../lib/admin';
import AdminGameSearch from '../../components/AdminGameSearch.astro';
import { adminGameSearch, type AdminMatch } from '../../lib/game-sources';
import { searchEnabled } from '../../lib/search';
import { ensureMigrated, getPool } from '../../lib/services';
import { Badge } from '../../components/ui/badge';
import { Button, buttonVariants } from '../../components/ui/button';
import { Card, CardContent } from '../../components/ui/card';
import { Input } from '../../components/ui/input';
// Middleware already limits /admin to signed-in admins; the check is repeated because this page also handles POST.
if (!isAdmin(Astro.locals.user)) return new Response('Not found', { status: 404 });
await ensureMigrated();
void resumeQueue();
let msg: string | null = null;
if (Astro.request.method === 'POST') {
  const h = Astro.request.headers;
  if (!sameOrigin(h.get('origin'), h.get('referer'), h.get('x-forwarded-host') ?? h.get('host'))) return new Response('Bad origin', { status: 403 });
  const f = await Astro.request.formData();
  const id = Number(f.get('id')); const action = String(f.get('action'));
  const me = Astro.locals.user!.id;
  if (action === 'queue-top10') {
    const r = await queueTopGames(me);
    msg = 'error' in r ? r.error : `BGG top 10: queued ${r.queued.length}${r.queued.length ? ` (${r.queued.join(', ')})` : ''}; skipped ${r.skipped.length}${r.skipped.length ? ` (${r.skipped.map((s) => `${s.title}: ${s.reason}`).join(', ')})` : ''}.`;
  }
  else if (!Number.isInteger(id) || id < 1) msg = 'Bad request id.';
  else if (action === 'approve') { const r = await approveRequest(id, me, f.get('terms') === 'yes'); msg = r.ok ? `Request #${id} approved. Fetching, indexing and drafting facts in the background.` : (r.error ?? 'Could not approve.'); }
  else if (action === 'reject') msg = (await rejectRequest(id, me, String(f.get('reason') ?? 'not accepted'))) ? `Request #${id} rejected.` : 'Request was not waiting.';
  else if (action === 'recheck') { await runChecks(id); msg = `Checks re-run for #${id}.`; }
  else if (action === 'approve-game') { const r = await approveGame(id, me); msg = r.ok ? `Game #${id} approved. It is in the queue; the Scout will look for the publisher's rules.` : (r.error ?? 'Could not approve.'); }
  else if (action === 'edit-source') {
    const cur = (await getPool()!.query('SELECT name FROM game_requests WHERE id=$1', [id])).rows[0];
    const p = parseGameRequest({ name: f.get('name') || cur?.name, publisher: f.get('publisher'), rulebookUrl: f.get('rulebookUrl'), foundOn: f.get('foundOn'), language: 'en' });
    if (!p.ok) msg = p.error;
    else { const r = await editSource(id, me, p.value); msg = r.ok ? `Request #${id} source changed; rights checks re-run.` : (r.error ?? 'Could not save.'); }
  }
  else if (action === 'manual') {
    const cur = (await getPool()!.query('SELECT name FROM game_requests WHERE id=$1', [id])).rows[0];
    const p = parseGameRequest({ name: f.get('name') || cur?.name, publisher: f.get('publisher'), rulebookUrl: f.get('rulebookUrl'), foundOn: f.get('foundOn'), language: 'en' });
    if (!p.ok) msg = p.error;
    else { const r = await completeManual(id, me, p.value); msg = r.ok ? `Request #${id} sent to the rights checks.` : (r.error ?? 'Could not save.'); }
  }
  else msg = 'Unknown action.';
}
// Title search (GET ?q=): same pick list and rate limit as /request-game; results link to /admin/sources or start a request there.
const q = (Astro.url.searchParams.get('q') ?? '').replace(/\s+/g, ' ').trim().slice(0, 80);
const searchOn = searchEnabled();
let matches: AdminMatch[] | null = null; let searchError: string | null = null;
if (Astro.request.method === 'GET' && q.length >= 2 && searchOn) {
  const r = await adminGameSearch(Astro.locals.user!.id, q);
  if ('error' in r) { searchError = r.error; matches = []; } else matches = r.matches;
}
const rows = (await getPool()!.query(`SELECT r.*, u.display_name requester FROM game_requests r LEFT JOIN users u ON u.id=r.user_id ORDER BY (r.status IN ('submitted','checked','manual')) DESC, r.id DESC LIMIT 50`)).rows;
type Status = 'success' | 'warning' | 'danger' | 'secondary';
const verdictBadge: Record<string, Status> = { pass: 'success', problem: 'warning', blocked: 'danger' };
const termsBadge: Record<string, Status> = { clear: 'success', restricted: 'danger' };
const field = 'mt-1 bg-background';
const actionRow = 'mt-2 flex flex-wrap items-start gap-4';
---
<Admin title="Game requests">
  <p>Users pick a game from a search list (or describe it). Approving the game puts it in the Scout's queue; when the Scout cannot find a publisher rulebook, or search is off, the request lands here for manual research with a Google link. The Scout searches publisher-first (who makes it, their site, their rules or downloads page) and only then falls back to a direct rulebook PDF hit. It hands the rulebook link to the Rights Officer (code), which runs the rights checks (robots.txt, TDM reservation, opt-out headers, reachability). The Terms Agent then finds and reads the <b>publisher's</b> terms (not a CDN's); when rights pass and the terms are clearly fine, the source approves itself (audit-logged, kill switch ROGUE_AUTO_APPROVE_SOURCES=0). <b>You</b> only decide the cases it cannot clear. Approval allowlists that host and starts fetch, index and Librarian. Nothing was downloaded before approval.</p>
  <AdminGameSearch action="/admin/requests" q={q} matches={matches} error={searchError} searchOn={searchOn} />
  <form method="post" class="mb-3"><input type="hidden" name="action" value="queue-top10" /><Button type="submit" variant="outline">Queue BGG top 10</Button> <small>Admin-approved list of {BGG_TOP10_DATE} (docs/BGG_TOP10.md). Skips games already in Rogue or requested; each still goes through Scout, rights and terms checks.</small></form>
  {msg && <p><Badge variant="secondary" className="h-auto whitespace-normal">{msg}</Badge></p>}
  {rows.length === 0 && <Card className="text-base"><CardContent>No requests yet.</CardContent></Card>}
  {rows.map((r) => (
    <Card className="mb-3 text-base"><CardContent>
      <b>#{r.id} {r.name}</b> <Badge variant="secondary">{r.status}</Badge> {r.report && <Badge variant={verdictBadge[r.report.verdict] ?? 'secondary'}>auto check: {r.report.verdict}</Badge>}
      <div><small>{r.publisher} · {r.year ?? 'year ?'} · {r.language} · by {r.requester ?? 'deleted user'} · slug <code>{r.slug}</code></small></div>
      {r.bgg_id && <div><small>Picked from the list: <a href={`https://boardgamegeek.com/boardgame/${r.bgg_id}`} rel="noopener nofollow">BGG {r.bgg_id}</a></small></div>}
      {r.details && <div class="my-1 whitespace-pre-wrap"><b>User's description:</b> {r.details}</div>}
      {r.rulebook_url ? <div>Rulebook: <a href={r.rulebook_url} rel="noopener nofollow">{r.rulebook_url}</a>{r.found_on && <> · found on <a href={r.found_on} rel="noopener nofollow">{r.found_on}</a></>}</div> : <div><small>No rulebook link yet.</small></div>}
      {r.stage && !['approved','rejected'].includes(r.status) && <div><small>Stage: {r.stage}</small></div>}
      {r.report && <ul>{r.report.findings.map((x: { level: string; text: string }) => <li>{x.level === 'ok' ? '✅' : x.level === 'warn' ? '⚠️' : '⛔'} {x.text}</li>)}</ul>}
      {r.terms_check && (
        <div class="my-1.5">
          <Badge variant={termsBadge[r.terms_check.verdict] ?? 'warning'}>Terms Agent: {r.terms_check.verdict}</Badge>
          {r.terms_check.termsUrl && <> read <a href={r.terms_check.termsUrl} rel="noopener nofollow">{r.terms_check.termsUrl}</a></>}
          <ul>{r.terms_check.reasons.map((n: string) => <li>{n}</li>)}</ul>
          {r.terms_check.flags.length > 0 && <ul>{r.terms_check.flags.map((f: { kind: string; excerpt: string }) => <li>🚩 <b>{f.kind}</b>: {f.excerpt}</li>)}</ul>}
          <details><summary><small>Pages the agent tried</small></summary><ul>{r.terms_check.tried.map((n: string) => <li><small>{n}</small></li>)}</ul></details>
        </div>
      )}
      {r.scout && (
        <details class="my-1.5"><summary>Scout report for the Rights Officer and you: {r.scout.candidates.length} documents on the publisher page, {r.scout.termsFlags.length} terms flags</summary>
          {r.scout.candidates.length > 0 && <ul>{r.scout.candidates.map((c: { url: string; text: string; role: string; why: string }) => <li><b>{c.role}</b> <a href={c.url} rel="noopener nofollow">{c.text || c.url}</a> <small>({c.why})</small></li>)}</ul>}
          {r.scout.termsUrl && <div>Terms page: <a href={r.scout.termsUrl} rel="noopener nofollow">{r.scout.termsUrl}</a></div>}
          {r.scout.termsFlags.length > 0 && <ul>{r.scout.termsFlags.map((f: { kind: string; excerpt: string }) => <li>🚩 <b>{f.kind}</b>: {f.excerpt}</li>)}</ul>}
          {r.scout.notes.length > 0 && <ul>{r.scout.notes.map((n: string) => <li>{n}</li>)}</ul>}
          <small>Scout only proposes; flags show where to read first and never clear a site.</small>
        </details>
      )}
      {r.progress && <div><small>Pipeline: {r.progress}</small></div>}
      {r.reject_reason && <div><small>Rejected: {r.reject_reason}</small></div>}
      {r.status === 'submitted' && r.mode === 'pick' && !r.rulebook_url && (
        <div class={actionRow}>
          <form method="post"><input type="hidden" name="id" value={r.id} /><input type="hidden" name="action" value="approve-game" /><Button type="submit">Approve game (Scout looks for the rules)</Button></form>
          <form method="post" class="flex flex-wrap items-center gap-2"><input type="hidden" name="id" value={r.id} /><input type="hidden" name="action" value="reject" /><Input name="reason" aria-label="Reject reason" placeholder="reason" required maxLength={200} className="w-48 bg-background" /> <Button type="submit" variant="destructive">Reject</Button></form>
        </div>
      )}
      {['submitted', 'checked'].includes(r.status) && r.rulebook_url && (
        <details class="mt-2"><summary>Edit source (wrong publisher site or rulebook?)</summary>
          <form method="post" class="mt-2 grid max-w-[36rem] gap-1.5"><input type="hidden" name="id" value={r.id} /><input type="hidden" name="action" value="edit-source" />
            <label>Game title <Input name="name" defaultValue={r.name} maxLength={80} required className={field} /></label>
            <label>Publisher <Input name="publisher" defaultValue={r.publisher} maxLength={80} required className={field} /></label>
            <label>Rulebook link (publisher's own, https) <Input name="rulebookUrl" type="url" defaultValue={r.rulebook_url} required maxLength={400} className={field} /></label>
            <label>Publisher page (optional, Scout scans it and reads the terms) <Input name="foundOn" type="url" defaultValue={r.found_on ?? ''} maxLength={400} className={field} /></label>
            <Button type="submit" className="justify-self-start">Save and re-run rights checks</Button>
            <small>Clears the old checks, terms verdict and scout report, which belong to the old site.</small></form>
        </details>
      )}
      {r.status === 'manual' && (
        <div class="mt-2">
          <a data-slot="button" class={buttonVariants()} href={googleLink(adminSearchQuery(r.details ?? `${r.name} ${r.year ?? ''}`))} target="_blank" rel="noopener noreferrer">Search Google for the rulebook</a>
          <form method="post" class="mt-2 grid max-w-[36rem] gap-1.5"><input type="hidden" name="id" value={r.id} /><input type="hidden" name="action" value="manual" />
            <label>Game title <Input name="name" defaultValue={r.name} maxLength={80} required className={field} /></label>
            <label>Publisher <Input name="publisher" maxLength={80} required className={field} /></label>
            <label>Rulebook link (publisher's own, https) <Input name="rulebookUrl" type="url" required maxLength={400} className={field} /></label>
            <label>Publisher page (optional, Scout scans it and reads the terms) <Input name="foundOn" type="url" maxLength={400} className={field} /></label>
            <Button type="submit" className="justify-self-start">Save and run rights checks</Button></form>
          <form method="post" class="mt-2 flex flex-wrap items-center gap-2"><input type="hidden" name="id" value={r.id} /><input type="hidden" name="action" value="reject" /><Input name="reason" aria-label="Reject reason" placeholder="reason" required maxLength={200} className="w-48 bg-background" /> <Button type="submit" variant="destructive">Reject</Button></form>
        </div>
      )}
      {r.status === 'checked' && (
        <div class={actionRow}>
          {r.report?.verdict !== 'blocked' && (
            <form method="post" class="flex flex-wrap items-center gap-2"><input type="hidden" name="id" value={r.id} /><input type="hidden" name="action" value="approve" />
              <label class="flex items-center gap-2"><input type="checkbox" name="terms" value="yes" required class="size-4 accent-primary" /> I read the publisher's terms{r.terms_check?.site ? ` (${r.terms_check.site})` : ` (${r.report?.host})`}</label>
              <Button type="submit">Approve</Button></form>
          )}
          <form method="post" class="flex flex-wrap items-center gap-2"><input type="hidden" name="id" value={r.id} /><input type="hidden" name="action" value="reject" /><Input name="reason" aria-label="Reject reason" placeholder="reason" required maxLength={200} className="w-48 bg-background" /> <Button type="submit" variant="destructive">Reject</Button></form>
          <form method="post"><input type="hidden" name="id" value={r.id} /><input type="hidden" name="action" value="recheck" /><Button type="submit" variant="secondary">Re-run checks</Button></form>
        </div>
      )}
    </CardContent></Card>
  ))}
</Admin>
