---
import Base from '../../../layouts/Base.astro';
import { getGame, getClaims } from '../../../lib/kb';
import { buttonVariants } from '../../../components/ui/button';
import { buildAid, CARD_SIZES, nUp, resolveCardSize, t } from '@rogue/core';
const L = Astro.locals.locale;
const { slug } = Astro.params;
const game = await getGame(slug!);
if (!game) return new Response('Not found', { status: 404 });
const claims = await getClaims(slug!);
const size = resolveCardSize(Astro.url.searchParams.get('size'), game.card_size);
const aid = buildAid(claims, size.key, t(L, 'aid.cardTitle', { game: game.name }));
const shown = new Set(aid.sections.flatMap((s) => s.lines.map((l) => l.id)));
if (!shown.size) return new Response(t(L, 'aid.none'), { status: 404, headers: { 'content-type': 'text/plain; charset=utf-8' } });
// Only sources behind lines on the card: no claim without its source.
const srcs = [...new Map(claims.filter((c) => shown.has(c.id)).map((c) => [c.source_url, c])).values()];
// The cut-out sheet only makes sense for card stock sizes; page sizes print one per sheet.
const sheet = size.card && Astro.url.searchParams.get('sheet') === '1';
const grid = nUp(size);
const copies = sheet ? grid.count : 1;
const pageCss = sheet ? '@page { size: 8.5in 11in; margin: 0; }' : `@page { size: ${size.width} ${size.height}; margin: 0; }`;
const hc = Astro.url.searchParams.get('contrast') === 'high';
const link = (s: string, sh: boolean) => `?size=${s}${sh ? '&sheet=1' : ''}${hc ? '&contrast=high' : ''}`;
const toggle = `?size=${size.key}${sheet ? '&sheet=1' : ''}${hc ? '' : '&contrast=high'}`;
// Toolbar links styled as small buttons; the current size is filled. The toolbar never prints.
const tool = (on: boolean) => buttonVariants({ variant: on ? 'default' : 'outline', size: 'sm' });
---
<Base title={t(L, 'aid.title', { game: game.name })} bare>
  <style is:global>
    body { background:var(--muted); }
    .aid { background:var(--card); color:var(--card-foreground); box-sizing:border-box; padding:.12in; overflow:hidden; font-family: 'Helvetica Neue', Arial, sans-serif; line-height:1.25; display:flex; flex-direction:column; }
    .aid h1 { font-size:1.45em; margin:0; border-bottom:1.5px solid var(--card-foreground); padding-bottom:1.5pt; }
    .aid h2 { font-size:1.05em; margin:3pt 0 1pt; text-transform:uppercase; letter-spacing:.05em; }
    .aid ul { margin:0 0 0 1.1em; padding:0; } .aid li { margin-bottom:1.2pt; }
    .aid sup { font-size:.75em; color:var(--muted-foreground); }
    .aid .foot { margin-top:auto; font-size:.72em; color:var(--muted-foreground); border-top:1px solid var(--border); padding-top:1.5pt; }
    .single .aid { margin:1rem auto; box-shadow:0 2px 12px color-mix(in oklch, var(--foreground) 40%, transparent); }
    .tiles { background:var(--card); width:8.5in; height:11in; margin:1rem auto; box-sizing:border-box; padding:.25in; display:grid; align-content:start; justify-content:center; box-shadow:0 2px 12px color-mix(in oklch, var(--foreground) 40%, transparent); }
    .tiles .aid { outline:.5px dashed var(--border); } /* thin cut lines */
    .toolbar { text-align:center; padding:.6rem; font-family:system-ui; }
    .toolbar a, .toolbar button { margin:0 .3rem; }

    /* High-contrast print option (?contrast=high): pure black on white, no grey text, heavier rules. Print only (paper is always light). */
    @media print {
    .hc .sheet, .hc .aid, .hc .tiles { background:#fff !important; color:#000 !important; }
    .hc .sheet .sub, .hc .sheet .foot, .hc .aid .foot, .hc .aid sup, .hc .sheet sup { color:#000 !important; }
    .hc .sheet .sub, .hc .sheet .foot, .hc .aid .foot { border-color:#000 !important; }
    .hc .sheet td, .hc .sheet th { border:2px solid #000 !important; }
    .hc .sheet tr.on { background:#fff !important; color:#000 !important; outline:3px solid #000; }
    .hc .aid { outline:1px dashed #000 !important; }
    .hc .aid h1 { border-bottom-width:2.5px; }
    }
    @media print { body { background:#fff; } .toolbar { display:none; } .single .aid, .tiles { margin:0; box-shadow:none; } }
  </style>
  <style is:inline set:html={pageCss}></style>
  <div class="toolbar">
    <a href={`/games/${slug}`}>{t(L, 'common.back', { name: game.name })}</a>
    {t(L, 'aid.size')} {Object.values(CARD_SIZES).map((s) => <a data-slot="button" class={tool(s.key === size.key)} aria-current={s.key === size.key ? 'true' : undefined} href={link(s.key, sheet && s.card)} title={s.label}>{s.key}</a>)}
    {size.card && (sheet ? <a data-slot="button" class={tool(false)} href={link(size.key, false)}>{t(L, 'aid.oneCard')}</a> : <a data-slot="button" class={tool(false)} href={link(size.key, true)}>{t(L, 'aid.cutSheet', { n: grid.count })}</a>)}
    <button data-slot="button" class={buttonVariants({ size: 'sm' })} onclick="window.print()">{t(L, 'aid.print', { what: sheet ? t(L, 'aid.printSheet', { n: grid.count }) : size.label })}</button>
    <a data-slot="button" class={tool(hc)} href={toggle}>{t(L, hc ? 'print.contrastOff' : 'print.contrastOn')}</a>
  </div>
  <main id="main" class={hc ? 'bare hc' : 'bare'}><div class={sheet ? 'tiles' : 'single'} style={sheet ? `grid-template-columns:repeat(${grid.cols}, ${size.width});grid-auto-rows:${size.height}` : ''}>
    {Array.from({ length: copies }, (_, i) => (
      <div class="aid" aria-hidden={i > 0 ? 'true' : undefined} style={`width:${size.width};height:${size.height};font-size:${size.fontPt}pt`}>
        <h1>{aid.title}</h1>
        {aid.sections.filter((sec) => sec.lines.length).map((sec) => (<>
          <h2>{sec.title}</h2>
          <ul>{sec.lines.map((l) => <li>{l.text}{l.page && <sup> [{l.page}]</sup>}</li>)}</ul>
        </>))}
        <div class="foot">
          {aid.omitted > 0 && <>{t(L, aid.omitted === 1 ? 'aid.omittedOne' : 'aid.omittedMany', { n: aid.omitted })} </>}
          {t(L, 'common.sources')} {srcs.map((s) => `${s.source_title} (${s.publisher})`).join('; ')}. {t(L, 'aid.foot')}
        </div>
      </div>
    ))}
  </div></main>
  <script is:inline>
    // Fit check: shrink the text until the first card fits its height, then apply that size to every copy,
    // so print never clips the end. Copies are identical, so one measurement serves all.
    (function () {
      var cards = document.querySelectorAll('.aid'); if (!cards.length) return;
      var first = cards[0], pt = parseFloat(first.style.fontSize), min = pt * 0.75, limit = first.clientHeight;
      while (first.scrollHeight > limit + 1 && pt > min) { pt -= 0.1; first.style.fontSize = pt.toFixed(1) + 'pt'; }
      for (var i = 0; i < cards.length; i++) cards[i].style.fontSize = pt.toFixed(1) + 'pt';
      first.dataset.fit = first.scrollHeight > limit + 1 ? 'overflow' : 'ok';
      first.dataset.fontPt = pt.toFixed(1);
    })();
  </script>
</Base>
