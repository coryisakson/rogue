---
import Base from '../../../layouts/Base.astro';
import { getGame } from '../../../lib/kb';
import { askRules } from '../../../lib/chat';
const { slug } = Astro.params;
const game = await getGame(slug!);
if (!game) return new Response('Not found', { status: 404 });
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const voted = Astro.url.searchParams.get('voted');
const nextUrl = `/games/${slug}/ask?q=${encodeURIComponent(q)}`;
let res = null; let err = '';
const user = Astro.locals.user;
if (user && q.length >= 3) { try { res = await askRules(slug!, q); } catch (e) { err = 'The rules assistant is busy or offline. Please try again in a minute.'; console.warn('[ask]', (e as Error).message); } }
---
<Base title={`Ask about ${game.name}`}>
  <main>
    <h1>Ask about {game.name}</h1>
    <p><a href={`/games/${slug}`}>← {game.name} facts</a></p>
    {!user ? (
      <div class="card" style="max-width:28rem"><p style="margin-top:0"><b>Sign in to ask the rules assistant.</b> It uses AI compute, so it is for signed-in players. Facts and setup sheets stay open to everyone.</p><a class="btn" href={`/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`}>Sign in</a></div>
    ) : (<form method="get" style="margin:1rem 0">
      <input name="q" value={q} placeholder="e.g. What is the hand limit?" maxlength="300" required style="padding:.6rem;width:min(30rem,90%);border-radius:8px;border:0" />
      <button class="btn" type="submit" style="border:0;cursor:pointer">Ask</button>
    </form>)}
    {err && <div class="card"><b>{err}</b></div>}
    {res && (
      <div class="card" id="answer">
        <p style="font-size:1.1rem;margin-top:0">{res.answer}</p>
        {res.warning && <p><span class="pill bad">check</span> {res.warning}</p>}
        <small><span class="pill warn">AI answer from the publisher rulebook, can be wrong</span></small>
        {res.id && (
          <form method="post" action="/rate-answer" style="margin-top:.8rem;display:flex;gap:.5rem;align-items:center">
            <input type="hidden" name="answer" value={res.id} />
            <input type="hidden" name="next" value={nextUrl} />
            <small>Was this helpful?</small>
            <button class="btn" name="vote" value="up" type="submit" style="border:0;cursor:pointer">👍 Helpful</button>
            <button class="btn" name="vote" value="down" type="submit" style="border:0;cursor:pointer">👎 Not helpful</button>
            {voted && <small>Thanks, vote saved.</small>}
          </form>
        )}
      </div>
      <h2>Sources</h2>
      <div style="display:grid;gap:.6rem">
        {res.sources.map((s) => (
          <div class="card"><small><a href={s.url}>{s.title}</a> ({s.publisher}) · {s.section ?? `p.${s.page}`}</small><blockquote style="margin:.3rem 0 0;opacity:.8;font-size:.9rem">“{s.quote}…”</blockquote></div>
        ))}
      </div>
    )}
    <p style="opacity:.7"><small>Answers use only the indexed official rulebook. We link to the publisher's file and show short excerpts. Rules chat needs a free sign-in (GitHub, Google or Discord).</small></p>
  </main>
</Base>
