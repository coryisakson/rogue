---
// Asking moved onto the game page as a chat thread (Cory 2026-10-16). Old links and bookmarks keep working.
const { slug } = Astro.params;
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const target = `/games/${encodeURIComponent(slug!)}${q ? `?q=${encodeURIComponent(q)}#answer` : ''}`;
return new Response(null, { status: 302, headers: { location: target, 'cache-control': 'no-store' } });
---
