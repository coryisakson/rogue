---
import Base from '../../../layouts/Base.astro';
import { getGame, getClaims } from '../../../lib/kb';
import { buildSheet, t } from '@rogue/core';
const L = Astro.locals.locale;
const { slug } = Astro.params;
const game = await getGame(slug!);
if (!game) return new Response('Not found', { status: 404 });
const claims = await getClaims(slug!);
const players = Number(Astro.url.searchParams.get('players') ?? 0);
const setup = claims.filter((c) => c.topic === 'goal' || c.topic === 'lose' || c.topic === 'setup' || c.topic === 'turn');
const variants = claims.filter((c) => c.topic === 'player_count_variant' && c.player_count != null).sort((a, b) => (a.player_count ?? 0) - (b.player_count ?? 0));
const sheet = buildSheet(claims);
const srcs = [...new Map(claims.map((c) => [c.source_url, c])).values()];
if (!claims.length) return new Response(t(L, 'sheet.none'), { status: 404, headers: { 'content-type': 'text/plain; charset=utf-8' } });
---
<Base title={t(L, 'sheet.title', { game: game.name })} bare>
  <style is:global>
    body { background:#ccc; }
    .sheet { background:#fff; color:#111; width:5.5in; min-height:8.5in; margin:1rem auto; padding:.3in; font-family: 'Helvetica Neue', Arial, sans-serif; font-size:8.6pt; line-height:1.28; box-shadow:0 2px 12px #0006; }
    .sheet h1 { font-size:15pt; margin:0; }
    .sheet .sub { font-size:7.5pt; color:#555; border-bottom:2px solid #111; padding-bottom:3pt; margin-bottom:5pt; }
    .sheet ol { margin:4pt 0 4pt 14pt; padding:0; } .sheet li { margin-bottom:2.5pt; }
    .sheet table { width:100%; margin:4pt 0; font-size:9pt; } .sheet td, .sheet th { border:1.5px solid #111; text-align:center; padding:2pt; }
    .sheet tr.on { background:#ffd54a; font-weight:bold; }
    .sheet h2 { font-size:9.5pt; margin:6pt 0 2pt; text-transform:uppercase; letter-spacing:.05em; }
    .sheet .foot { font-size:6.5pt; color:#444; border-top:1px solid #999; margin-top:6pt; padding-top:3pt; }
    .toolbar { text-align:center; padding:.6rem; font-family:system-ui; }
    .toolbar a, .toolbar button { margin:0 .4rem; }
    @page { size: 5.5in 8.5in; margin: 0; }
    @media print { body { background:#fff; } .toolbar { display:none; } .sheet { margin:0; box-shadow:none; width:5.5in; height:8.5in; overflow:hidden; page-break-after:avoid; } }
  </style>
  <div class="toolbar">
    <a href={`/games/${slug}`}>{t(L, 'common.back', { name: game.name })}</a>
    {t(L, 'sheet.players')} {[2,3,4].map((n) => <a href={`?players=${n}`} style={players===n?'font-weight:bold':''}>{n}</a>)} <a href="?">{t(L, 'sheet.all')}</a>
    <button onclick="window.print()">{t(L, 'sheet.print')}</button>
  </div>
  <div class="sheet">
    <h1>{t(L, 'sheet.heading', { game: game.name })}</h1>
    <div class="sub">{game.publisher} · {t(L, 'common.players', { min: game.min_players, max: game.max_players })} · {t(L, 'common.edition', { edition: claims[0]?.edition ?? '' })}</div>
    {variants.length > 0 && (<>
      <h2>{t(L, 'sheet.byPlayers')}</h2>
      <table class="pc"><tr><th>{t(L, 'sheet.thPlayers')}</th><th>{t(L, 'sheet.thChanges')}</th></tr>
        {variants.map((v) => <tr class={players === v.player_count ? 'on' : ''}><td>{v.player_count}</td><td style="text-align:left">{v.body}{v.locator && <sup> [{v.locator}]</sup>}</td></tr>)}
      </table>
    </>)}
    {variants.length === 0 && (<p class="none"><em>{t(L, 'sheet.noVariants')}</em></p>)}
    {sheet.sections.filter((sec) => sec.lines.length).map((sec) => (<>
      <h2>{sec.title}</h2>
      <ol>{sec.lines.map((l) => <li>{l.text}{l.page && <sup> [{l.page}]</sup>}</li>)}</ol>
    </>))}
    <div class="foot">{t(L, 'common.sources')} {srcs.map((s) => `${s.source_title} (${s.publisher})`).join('; ')}. {t(L, 'sheet.foot')}</div>
  </div>
  <script is:inline>
    // Fit check: shrink the text until the sheet fits one half-letter page, so print never clips the end.
    (function () {
      var sheet = document.querySelector('.sheet'); if (!sheet) return;
      var pt = 8.6, limit = 8.5 * 96;
      sheet.style.fontSize = pt + 'pt';
      while (sheet.scrollHeight > limit + 1 && pt > 6.2) { pt -= 0.1; sheet.style.fontSize = pt.toFixed(1) + 'pt'; }
      sheet.dataset.fit = sheet.scrollHeight > limit + 1 ? 'overflow' : 'ok';
      sheet.dataset.fontPt = pt.toFixed(1);
    })();
  </script>
</Base>
