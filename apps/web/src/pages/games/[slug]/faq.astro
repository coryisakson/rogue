---
import Base from '../../../layouts/Base.astro';
import { getGame } from '../../../lib/kb';
import { publicFaq } from '../../../lib/faq';
import { formatNumber, t } from '@rogue/core';
import { Badge } from '../../../components/ui/badge';
import { Card, CardContent } from '../../../components/ui/card';
const L = Astro.locals.locale;
const { slug } = Astro.params;
const game = await getGame(slug!);
if (!game) return new Response('Not found', { status: 404 });
let items: Awaited<ReturnType<typeof publicFaq>> = [];
try { items = await publicFaq(slug!); } catch (e) { console.warn('[faq]', (e as Error).message); }
---
<Base title={t(L, 'faq.title', { game: game.name })}>
  <main id="main">
    <h1>{t(L, 'faq.h1', { game: game.name })}</h1>
    <p><a href={`/games/${slug}`}>{t(L, 'common.back', { name: game.name })}</a> · <a href={`/games/${slug}/ask`}>{t(L, 'faq.askOwn')}</a></p>
    <p class="text-muted-foreground"><small>{t(L, 'faq.note')}</small></p>
    {items.length === 0 && <Card className="text-base"><CardContent>{t(L, 'faq.empty')}</CardContent></Card>}
    <div class="grid gap-3">
      {items.map((f) => (
        <Card className="text-base"><CardContent>
          <h2 class="mt-0 mb-1.5 text-lg">{f.question}</h2>
          <p class="my-1">{f.answer}</p>
          <small><Badge variant="secondary">{t(L, 'faq.helpful', { up: formatNumber(L, f.up), total: formatNumber(L, f.total) })}</Badge> {f.sources && f.sources.length > 0 && <>· {t(L, 'common.sources')} {f.sources.slice(0, 3).map((s, i) => <>{i > 0 && ', '}<a href={s.url}>{s.section ?? `p.${s.page}`}</a></>)}</>}</small>
        </CardContent></Card>
      ))}
    </div>
  </main>
</Base>
