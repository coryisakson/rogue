---
import Base from '../../../layouts/Base.astro';
import { getGame, getClaims } from '../../../lib/kb';
import { ratingLabel } from '@rogue/core';
const { slug } = Astro.params;
const game = await getGame(slug!);
if (!game) return new Response('Not found', { status: 404 });
const user = Astro.locals.user;
const claims = await getClaims(slug!, user ? { userId: user.id } : {});
const here = Astro.url.pathname + Astro.url.search;
const sources = [...new Map(claims.map((c) => [c.source_url, c])).values()];
const q = Astro.url.searchParams.get('q');
const links = claims.filter((c) => c.topic === 'companion');
const rest = claims.filter((c) => c.topic !== 'companion');
const shown = q ? rest.filter((c) => c.body.toLowerCase().includes(q.toLowerCase())) : rest;
---
<Base title={game.name}>
  <main>
    <h1>{game.name}</h1>
    <p>{game.publisher} · {game.year} · {game.min_players}–{game.max_players} players {game.bgg_id && <>· <a href={`https://boardgamegeek.com/boardgame/${game.bgg_id}`}>BoardGameGeek ↗</a></>}</p>
    <p><a class="btn" href={`/games/${slug}/setup`}>Setup one-pager</a> <a class="btn" href={`/games/${slug}/ask`} style="background:#cdbf9b">Ask the rules</a> <a class="btn" href={`/games/${slug}/faq`} style="background:#cdbf9b">FAQ</a></p>
    <form method="get" style="margin:1rem 0"><input name="q" value={q ?? ''} placeholder="Search this game's facts…" style="padding:.5rem;width:min(24rem,80%);border-radius:8px;border:0" /> <button class="btn" style="border:0">Search</button></form>
    {links.length > 0 && (
      <div class="card" id="links">
        <h2 style="margin-top:0">Companion app and links</h2>
        <p style="opacity:.8"><small>QR codes printed in the publisher's rulebook. We only list the link; check the address before you open it.</small></p>
        <ul>
          {links.map((c) => {
            const url = c.body.match(/https?:\/\/\S+(?=\s\()/)?.[0];
            return <li id={`c${c.id}`}>{url ? <a href={url} rel="noopener nofollow">{url}</a> : c.body} · <small>{c.locator} of <a href={c.source_url}>{c.source_title}</a></small></li>;
          })}
        </ul>
      </div>
    )}
    {claims.length === 0 && <div class="card"><b>No cited facts yet.</b> We have not ingested an official source for this game. If you are the publisher, you can <a href="/about#publishers">contact us</a> to authorise one.</div>}
    <div style="display:grid;gap:.8rem">
      {shown.map((c) => (
        <div class="card" id={`c${c.id}`}>
          <span class="pill">{c.topic.replace('_', ' ')}</span>{c.player_count && <span class="pill warn">{c.player_count} players</span>}
          <p style="margin:.4rem 0">{c.body}</p>
          <small>Source: <a href={c.source_url}>{c.source_title}</a> ({c.publisher}) · {c.locator}
          {c.availability !== 'available' && <span class="pill bad">source no longer available</span>}
          · {c.verified_at ? <span class="pill">Human-reviewed</span> : <span class="pill">AI-verified</span>}</small>
          {c.quote && <blockquote style="margin:.4rem 0 0;opacity:.8;font-size:.9rem">“{c.quote}”</blockquote>}
          <form method="post" action="/rate" style="margin:.5rem 0 0;display:flex;gap:.3rem;align-items:center;flex-wrap:wrap">
            <input type="hidden" name="claim" value={c.id} /><input type="hidden" name="next" value={here} />
            <small>{user ? 'Rate this fact:' : <a href={`/login?next=${encodeURIComponent(here)}`}>Sign in to rate</a>}</small>
            {user && [1, 2, 3, 4, 5].map((n) => <button type="submit" name="stars" value={n} title={`${n} star${n > 1 ? 's' : ''}`} style={`background:none;border:0;cursor:pointer;font-size:1.2rem;padding:0 .1rem;color:${(c.my_stars ?? 0) >= n ? '#d9a441' : '#0004'}`}>★</button>)}
            {ratingLabel(c.avg_stars, c.rating_count) && <small>· {ratingLabel(c.avg_stars, c.rating_count)}</small>}
          </form>
        </div>
      ))}
    </div>
    <h2>Sources</h2>
    <ul>{sources.map((s) => <li><a href={s.source_url}>{s.source_title}</a> · {s.publisher} · edition: {s.edition} · {s.availability === 'available' ? 'available' : 'no longer available'}</li>)}</ul>
    <p style="opacity:.7"><small>We link to the publisher's file and quote only short passages. We do not host rulebooks.</small></p>
  </main>
</Base>
