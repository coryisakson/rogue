---
import Base from '../../../layouts/Base.astro';
import { getGame, getClaims } from '../../../lib/kb';
import { askRules, gameSources, spendChatBudget, type ChatAnswer } from '../../../lib/chat';
import { recordAsk } from '../../../lib/unanswered';
import { MAX_THREAD_TURNS, THREAD_WARN_TURN, clientStrings, groupCitations, langTag, pageList, t } from '@rogue/core';
const { slug } = Astro.params;
const game = await getGame(slug!);
if (!game) return new Response('Not found', { status: 404 });
const user = Astro.locals.user;
const L = Astro.locals.locale;
// The game page is a chat (Cory 2026-10-16). The fact list lives on /games/<slug>/facts; here we only need companion links and documents.
const links = await getClaims(slug!, { topic: 'companion' });
const sources = await gameSources(slug!);
// Without JavaScript the ask box is a plain GET form: ?q= renders that one answer here.
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const voted = Astro.url.searchParams.get('voted');
const nextUrl = `/games/${slug}?q=${encodeURIComponent(q)}`;
let res: ChatAnswer | null = null; let err = '';
if (user && q.length >= 3) {
  // A single question without history (no-JS form). The page reloads after a vote; that is not a new ask, so it is not counted again.
  const budget = voted ? null : spendChatBudget(user, 0, L);
  if (budget && !budget.ok) err = budget.message;
  else {
    try { res = await askRules(slug!, q, [], L); } catch (e) { err = t(L, 'chat.busy'); console.warn('[ask]', (e as Error).message); }
    if (!voted) recordAsk(slug!, q, 'web', res ?? { error: err });
  }
}
const docs = res ? groupCitations(res.sources) : [];
const loginUrl = `/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;
const reddit = `https://www.reddit.com/search/?q=${encodeURIComponent(`${game.name} board game rules`)}`;
// Strings for the chat script below (it must not hard-code English).
const chatStrings = JSON.stringify(clientStrings(L, ['chat.aiNote', 'chat.check', 'chat.quote', 'chat.helpfulQ', 'chat.helpful', 'chat.notHelpful',
  'chat.voteSaved', 'chat.voteTooMany', 'chat.voteFailed', 'chat.thinking', 'chat.meter', 'chat.meterWarn', 'chat.meterFull', 'chat.fullError',
  'chat.genericError', 'chat.offline', 'chat.newConversation', 'chat.startNew', 'nav.signin']));
---
<Base title={game.name}>
  <style>
    .thread { display: grid; gap: .8rem; margin: 1rem 0; max-width: 46rem }
    .turn { display: grid; gap: .4rem }
    .q-bubble { justify-self: end; max-width: 85%; background: var(--color-secondary); color: var(--color-on-secondary); padding: .55rem .85rem; border-radius: 14px 14px 2px 14px; white-space: pre-line }
    .a-bubble { max-width: 92%; margin: 0; border-radius: 14px 14px 14px 2px }
    .a-text { font-size: 1.05rem; margin-top: 0; white-space: pre-line }
    .a-docs { margin: .5rem 0 0; padding-left: 1.1rem }
    .a-docs blockquote { margin: .3rem 0 0; opacity: .8; font-size: .9rem }
    .vote { margin-top: .8rem; display: flex; gap: .5rem; align-items: center; flex-wrap: wrap }
    .thinking { display: flex; gap: .6rem; align-items: center }
    .spinner { width: 1rem; height: 1rem; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: spin .8s linear infinite; flex: none }
    @keyframes spin { to { transform: rotate(360deg) } }
    @media (prefers-reduced-motion: reduce) { .spinner { animation: none; border-right-color: currentColor; opacity: .5 } }
    #chat-meter { margin: -.6rem 0 1rem; opacity: .8 }
  </style>
  <main id="main">
    <h1>{game.name}</h1>
    <p>{game.publisher} · {game.year} · {t(L, 'common.players', { min: game.min_players, max: game.max_players })} {game.bgg_id && <>· <a href={`https://boardgamegeek.com/boardgame/${game.bgg_id}`}>BoardGameGeek ↗</a></>}</p>

    <div class="thread" id="thread" aria-live="polite" data-i18n={chatStrings}>
      {(res || err) && (
        <div class="turn" data-answer-id={res?.id ?? ''}>
          <div class="q-bubble">{q}</div>
          {err ? <div class="card a-bubble"><b>{err}</b></div> : res && (
            <div class="card a-bubble" id="answer">
              <p class="a-text">{res.answer}</p>
              {res.warning && <p><span class="pill bad">{t(L, 'chat.check')}</span> {res.warning}</p>}
              <small><span class="pill warn">{t(L, 'chat.aiNote')}</span></small>
              {docs.length > 0 && (
                <ul class="a-docs">
                  {docs.map((d) => (
                    <li><small><a href={d.url}>{d.title}</a>{d.publisher && ` (${d.publisher})`}{d.pages.length > 0 && ` · ${pageList(d.pages)}`}{d.lang && ` · ${langTag(d.lang)}`}</small>
                      {d.quote && <details><summary><small>{t(L, 'chat.quote')}</small></summary><blockquote lang={d.lang ?? undefined}>“{d.quote}…”</blockquote></details>}
                    </li>
                  ))}
                </ul>
              )}
              {res.id && (
                <form method="post" action="/rate-answer" class="vote" data-vote>
                  <input type="hidden" name="answer" value={res.id} />
                  <input type="hidden" name="next" value={nextUrl} />
                  <small>{t(L, 'chat.helpfulQ')}</small>
                  <button class="btn" name="vote" value="up" type="submit" style="border:0;cursor:pointer">{t(L, 'chat.helpful')}</button>
                  <button class="btn" name="vote" value="down" type="submit" style="border:0;cursor:pointer">{t(L, 'chat.notHelpful')}</button>
                  {voted && <small>{t(L, 'chat.voteSaved')}</small>}
                </form>
              )}
            </div>
          )}
        </div>
      )}
    </div>

    {!user ? (
      <div class="card" style="max-width:28rem"><p style="margin-top:0"><b>{t(L, 'chat.signInTitle')}</b> {t(L, 'chat.signInBody')}</p><a class="btn" href={loginUrl}>{t(L, 'nav.signin')}</a></div>
    ) : (
      <form id="ask-form" method="get" action={`/games/${slug}`} data-game={slug} data-max-turns={MAX_THREAD_TURNS} data-warn-turn={THREAD_WARN_TURN} style="margin:1rem 0;display:flex;gap:.5rem;flex-wrap:wrap;max-width:46rem">
        <input name="q" aria-label={t(L, 'chat.placeholder', { game: game.name })} placeholder={t(L, 'chat.placeholder', { game: game.name })} maxlength="300" minlength="3" required autocomplete="off" style="padding:.7rem .9rem;font-size:1.05rem;flex:1;min-width:14rem;border-radius:8px;border:0" />
        <button class="btn" type="submit" style="border:0;cursor:pointer">{t(L, 'chat.ask')}</button>
        <button class="btn" type="button" id="chat-clear" hidden style="border:0;cursor:pointer;background:var(--color-secondary)">{t(L, 'chat.newConversation')}</button>
      </form>
    )}
    {user && <p id="chat-meter" hidden aria-live="polite"><small></small></p>}
    <p><small style="opacity:.8">{t(L, 'chat.citesNote')}</small></p>

    <p><a class="btn" href={`/games/${slug}/setup`}>{t(L, 'game.setup')}</a> <a class="btn" href={`/games/${slug}/aid`}>{t(L, 'game.aid')}</a> <a class="btn" href={`/games/${slug}/faq`} style="background:var(--color-secondary)">{t(L, 'game.faq')}</a></p>
    {links.length > 0 && (
      <div class="card" id="links">
        <h2 style="margin-top:0">{t(L, 'game.linksTitle')}</h2>
        <p style="opacity:.8"><small>{t(L, 'game.linksNote')}</small></p>
        <ul>
          {links.map((c) => {
            const url = c.body.match(/https?:\/\/\S+(?=\s\()/)?.[0];
            return <li id={`c${c.id}`}>{url ? <a href={url} rel="noopener nofollow">{url}</a> : c.body} · <small>{c.locator} · <a href={c.source_url}>{c.source_title}</a></small></li>;
          })}
        </ul>
      </div>
    )}
    <div class="card" id="community">
      <h2 style="margin-top:0">{t(L, 'game.communityTitle')}</h2>
      <ul>
        {game.bgg_id && <li><a href={`https://boardgamegeek.com/boardgame/${game.bgg_id}/forums`} rel="noopener nofollow">{t(L, 'game.bggForums')}</a></li>}
        <li><a href={reddit} rel="noopener nofollow">{t(L, 'game.reddit')}</a></li>
      </ul>
      <p style="opacity:.8;margin-bottom:0"><small>{t(L, 'game.communityNote')}</small></p>
    </div>
    {sources.length === 0 && <div class="card"><b>{t(L, 'game.noSourcesTitle')}</b> {t(L, 'game.noSourcesBody')} <a href="/about#publishers">{t(L, 'game.contactUs')}</a> {t(L, 'game.noSourcesEnd')}</div>}
    {sources.length > 0 && <>
      <h2>{t(L, 'game.sourcesTitle')}</h2>
      <ul>{sources.map((s) => <li><a href={s.url}>{s.title ?? s.url}</a>{s.publisher && ` · ${s.publisher}`} · {t(L, 'common.edition', { edition: s.edition })}{s.language && ` · ${langTag(s.language)}`}{s.availability !== 'available' && ` · ${t(L, 'game.unavailable')}`}</li>)}</ul>
    </>}
    <p style="opacity:.7"><small>{t(L, 'game.rightsNote')}</small></p>
    <p style="opacity:.6"><small><a href={`/games/${slug}/facts`}>{t(L, 'game.factBase')}</a></small></p>
  </main>
  <script is:inline>
    // Chat thread: asks go to /api/ask and answers are appended here, so earlier turns stay on screen.
    // The thread lives in page memory only: leaving or reloading the page clears it (Cory 2026-10-16). Nothing is stored in the browser or on the server.
    // Without JavaScript none of this runs and the form does a plain GET ?q= instead.
    (() => {
      const form = document.getElementById('ask-form');
      const thread = document.getElementById('thread');
      if (!form || !thread) return;
      const game = form.dataset.game;
      const KEY = `rogue-chat:${game}`;
      // Server limits (12 turns per thread, warning from turn 10). The server re-checks; this only keeps the UI honest.
      const MAX_TURNS = Number(form.dataset.maxTurns) || 12;
      const WARN_TURN = Number(form.dataset.warnTurn) || 10;
      const clearBtn = document.getElementById('chat-clear');
      const input = form.querySelector('input[name="q"]');
      const askBtn = form.querySelector('button[type="submit"]');
      const meter = document.getElementById('chat-meter');
      // UI strings in the page language, from the server (data-i18n on #thread); {name} placeholders are filled here.
      const S = JSON.parse(thread.dataset.i18n || '{}');
      const tr = (k, v) => (S[k] || k).replace(/\{(\w+)\}/g, (m, n) => (v && n in v ? String(v[n]) : m));

      window.addEventListener("pageshow", (e) => { if (e.persisted) location.reload(); }); // back button must not resurrect an old thread
      let memory = [];
      const load = () => memory;
      const save = (turns) => { memory = turns.slice(-MAX_TURNS); };

      // Small DOM builder; text always goes in via textContent, never as HTML.
      function el(tag, props = {}, ...kids) {
        const n = document.createElement(tag);
        for (const [k, v] of Object.entries(props)) {
          if (k === 'class') n.className = v; else if (k === 'text') n.textContent = v; else n.setAttribute(k, v);
        }
        for (const k of kids) if (k) n.append(k);
        return n;
      }
      const safeUrl = (u) => (/^https?:\/\//.test(u) ? u : '#');

      function answerCard(t) {
        if (t.error) return el('div', { class: 'card a-bubble' }, el('b', { text: t.error }), t.signIn ? el('p', {}, el('a', { class: 'btn', href: `/login?next=${encodeURIComponent(location.pathname)}`, text: tr('nav.signin') })) : null);
        const card = el('div', { class: 'card a-bubble' }, el('p', { class: 'a-text', text: t.answer }));
        if (t.warning) card.append(el('p', {}, el('span', { class: 'pill bad', text: tr('chat.check') }), ` ${t.warning}`));
        card.append(el('small', {}, el('span', { class: 'pill warn', text: tr('chat.aiNote') })));
        if (t.docs && t.docs.length) {
          const ul = el('ul', { class: 'a-docs' });
          for (const d of t.docs) {
            const line = el('small', {}, el('a', { href: safeUrl(d.url), text: d.title }), d.publisher ? ` (${d.publisher})` : '', d.cite ? ` · ${d.cite}` : '', d.tag ? ` · ${d.tag}` : '');
            const quote = d.quote ? el('details', {}, el('summary', {}, el('small', { text: tr('chat.quote') })), el('blockquote', d.lang ? { lang: d.lang, text: `“${d.quote}…”` } : { text: `“${d.quote}…”` })) : null;
            ul.append(el('li', {}, line, quote));
          }
          card.append(ul);
        }
        if (t.id) {
          const vote = el('form', { method: 'post', action: '/rate-answer', class: 'vote', 'data-vote': '' },
            el('input', { type: 'hidden', name: 'answer', value: String(t.id) }),
            el('input', { type: 'hidden', name: 'next', value: `/games/${game}?q=${encodeURIComponent(t.q)}` }),
            el('small', { text: tr('chat.helpfulQ') }),
            el('button', { class: 'btn', name: 'vote', value: 'up', type: 'submit', style: 'border:0;cursor:pointer', text: tr('chat.helpful') }),
            el('button', { class: 'btn', name: 'vote', value: 'down', type: 'submit', style: 'border:0;cursor:pointer', text: tr('chat.notHelpful') }));
          card.append(vote);
        }
        return card;
      }

      // Shows the thread size as turns (what the limit counts), warns near the end, and locks the box at the limit.
      function updateMeter(full) {
        const n = load().length;
        const atLimit = full || n >= MAX_TURNS;
        input.disabled = atLimit;
        if (askBtn) askBtn.disabled = atLimit;
        if (clearBtn) clearBtn.textContent = atLimit ? tr('chat.startNew') : tr('chat.newConversation');
        if (!meter) return;
        meter.hidden = n === 0 && !atLimit;
        const text = meter.querySelector('small');
        if (atLimit) text.textContent = tr('chat.meterFull', { n: Math.min(n, MAX_TURNS), max: MAX_TURNS });
        else if (n + 1 >= WARN_TURN) text.textContent = tr('chat.meterWarn', { n: n + 1, max: MAX_TURNS });
        else text.textContent = tr('chat.meter', { n: n + 1, max: MAX_TURNS });
      }

      function addTurn(t) {
        const turn = el('div', { class: 'turn', 'data-answer-id': t.id ? String(t.id) : '' }, el('div', { class: 'q-bubble', text: t.q }));
        turn.append(t.pending
          ? el('div', { class: 'card a-bubble thinking', role: 'status' }, el('span', { class: 'spinner', 'aria-hidden': 'true' }), el('span', { text: tr('chat.thinking') }))
          : answerCard(t));
        thread.append(turn);
        if (clearBtn) clearBtn.hidden = false;
        return turn;
      }

      // Earlier turns go above a server-rendered answer (?q=), skipping it if it is the same answer.
      const serverTurn = thread.querySelector('.turn');
      const serverId = serverTurn ? serverTurn.dataset.answerId : '';
      for (const t of load()) {
        if (serverId && String(t.id) === serverId) continue;
        const n = addTurn(t);
        if (serverTurn) thread.insertBefore(n, serverTurn);
      }
      if (serverTurn && clearBtn) clearBtn.hidden = false;
      updateMeter(false);

      // The box clears at once and the button stays usable: questions typed while an answer is loading wait in a queue and
      // are sent one at a time, so each follow-up can see the answer before it (Cory 2026-10-16).
      const queue = []; let working = false; let stopped = false; let gen = 0;
      async function work() {
        if (working) return; working = true;
        while (queue.length) {
          const { q, turn, g } = queue.shift();
          if (g !== gen) continue; // thread was cleared while this was waiting
          if (stopped) { turn.replaceWith(addTurn({ q, error: tr('chat.fullError') })); continue; }
          let t; let full = false;
          const prior = load().map((x) => ({ q: x.q, a: x.answer || '' }));
          // aria-busy holds back screen-reader announcements of the live thread until the answer is in place.
          thread.setAttribute('aria-busy', 'true');
          try {
            const r = await fetch('/api/ask', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ game, q, history: prior }) });
            const body = await r.json().catch(() => ({}));
            if (body.limit) { t = { q, error: body.message }; full = body.limit === 'thread'; }
            else t = r.ok ? { q, id: body.id, answer: body.answer, warning: body.warning, docs: body.docs } : { q, error: body.error || tr('chat.genericError'), signIn: r.status === 401 };
          } catch {
            t = { q, error: tr('chat.offline') };
          }
          thread.removeAttribute('aria-busy');
          if (g !== gen) continue;
          turn.replaceWith(addTurn(t));
          if (!t.error) save([...load(), t]);
          if (full) stopped = true;
          updateMeter(full);
        }
        working = false;
        if (!input.disabled) input.focus(); else if (clearBtn) clearBtn.focus();
      }
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const q = input.value.trim();
        if (q.length < 3 || stopped) return;
        input.value = ''; // clear straight away so the next question can be typed while this one loads
        const turn = addTurn({ q, pending: true });
        const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
        turn.scrollIntoView({ behavior: calm ? 'auto' : 'smooth', block: 'nearest' });
        queue.push({ q, turn, g: gen });
        work();
      });

      // Votes are sent in the background so the thread is not reloaded (rate-answer answers with a redirect).
      thread.addEventListener('submit', async (e) => {
        const vote = e.target;
        if (!(vote instanceof HTMLFormElement) || !('vote' in vote.dataset)) return;
        e.preventDefault();
        const data = new FormData(vote, e.submitter);
        for (const b of vote.querySelectorAll('button')) b.disabled = true;
        let msg = tr('chat.voteSaved');
        try {
          const r = await fetch(vote.action, { method: 'POST', body: data, redirect: 'manual' });
          if (r.type !== 'opaqueredirect' && !r.ok) msg = r.status === 429 ? tr('chat.voteTooMany') : tr('chat.voteFailed');
        } catch { msg = tr('chat.voteFailed'); }
        for (const s of vote.querySelectorAll('[data-vote-msg]')) s.remove();
        vote.append(el('small', { 'data-vote-msg': '', text: msg }));
        for (const b of vote.querySelectorAll('button')) b.disabled = false;
      });

      if (clearBtn) clearBtn.addEventListener('click', () => {
        memory = []; queue.length = 0; stopped = false; gen++;
        thread.replaceChildren();
        clearBtn.hidden = true;
        if (location.search) history.replaceState(null, '', location.pathname);
        updateMeter(false);
        input.focus();
      });
    })();
  </script>
</Base>
