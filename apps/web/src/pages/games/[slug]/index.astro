---
import Base from '../../../layouts/Base.astro';
import { getGame, getClaims } from '../../../lib/kb';
import { askRules, gameSources, spendChatBudget, type ChatAnswer } from '../../../lib/chat';
import { recordAsk } from '../../../lib/unanswered';
import { Badge } from '../../../components/ui/badge';
import { Button, buttonVariants } from '../../../components/ui/button';
import { Card, CardContent, CardHeader, CardTitle } from '../../../components/ui/card';
import { Input } from '../../../components/ui/input';
import { MAX_THREAD_TURNS, THREAD_WARN_TURN, clientStrings, groupCitations, langTag, pageList, splitWikiSources, t } from '@rogue/core';
const { slug } = Astro.params;
const game = await getGame(slug!);
if (!game) return new Response('Not found', { status: 404 });
const user = Astro.locals.user;
const L = Astro.locals.locale;
// The game page is a chat (Cory 2026-10-16). The fact list lives on /games/<slug>/facts; here we only need companion links and documents.
const links = await getClaims(slug!, { topic: 'companion' });
const sources = await gameSources(slug!);
// A wiki import adds one source per page: they show as one collapsed "Wiki (N pages)" entry.
const { other: mainSources, wiki: wikiSources } = splitWikiSources(sources);
// A wiki an admin attested as the publisher's official documentation is listed as "Publisher wiki", others as "Community wiki".
const wikiGroups = [
  { key: 'game.publisherWikiPages', pages: wikiSources.filter((s) => s.authority === 'publisher') },
  { key: 'game.communityWikiPages', pages: wikiSources.filter((s) => s.authority !== 'publisher') },
] as const;
// Without JavaScript the ask box is a plain GET form: ?q= renders that one answer here.
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const voted = Astro.url.searchParams.get('voted');
const nextUrl = `/games/${slug}?q=${encodeURIComponent(q)}`;
let res: ChatAnswer | null = null; let err = '';
if (user && q.length >= 3) {
  // A single question without history (no-JS form). The page reloads after a vote; that is not a new ask, so it is not counted again.
  const budget = voted ? null : spendChatBudget(user, 0, L);
  if (budget && !budget.ok) err = budget.message;
  else {
    try { res = await askRules(slug!, q, [], L); } catch (e) { err = t(L, 'chat.busy'); console.warn('[ask]', (e as Error).message); }
    if (!voted) recordAsk(slug!, q, 'web', res ?? { error: err });
  }
}
const docs = res ? groupCitations(res.sources) : [];
const loginUrl = `/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;
const reddit = `https://www.reddit.com/search/?q=${encodeURIComponent(`${game.name} board game rules`)}`;
// Strings for the chat script below (it must not hard-code English).
const chatStrings = JSON.stringify(clientStrings(L, ['chat.aiNote', 'chat.check', 'chat.quote', 'chat.helpfulQ', 'chat.helpful', 'chat.notHelpful',
  'chat.voteSaved', 'chat.voteTooMany', 'chat.voteFailed', 'chat.thinking', 'chat.meter', 'chat.meterWarn', 'chat.meterFull', 'chat.fullError',
  'chat.genericError', 'chat.offline', 'chat.newConversation', 'chat.startNew', 'nav.signin']));
// Chat layout classes, used by the server-rendered answer (no-JS ?q=) and by the #chat-ui template the chat script copies.
const chat = {
  turn: 'grid gap-1.5',
  q: 'max-w-[85%] justify-self-end whitespace-pre-line rounded-2xl rounded-br-sm bg-secondary px-3.5 py-2 text-secondary-foreground',
  a: 'max-w-[92%] rounded-2xl rounded-bl-sm text-base',
  text: 'mt-0 whitespace-pre-line text-[1.05rem]',
  docs: 'mt-2 mb-0 pl-[1.1rem]',
  quote: 'mx-0 mt-1 mb-0 text-sm text-muted-foreground',
  vote: 'mt-3 flex flex-wrap items-center gap-2',
  thinking: 'flex flex-row items-center gap-2.5',
  spinner: 'size-4 flex-none animate-spin rounded-full border-2 border-current border-r-transparent motion-reduce:animate-none motion-reduce:border-r-current motion-reduce:opacity-50',
};
const linkButton = (variant: 'default' | 'secondary' = 'default') => buttonVariants({ variant, size: 'lg' });
---
<Base title={game.name}>
  <main id="main">
    <h1>{game.name}</h1>
    <p>{game.publisher} · {game.year} · {t(L, 'common.players', { min: game.min_players, max: game.max_players })} {game.bgg_id && <>· <a href={`https://boardgamegeek.com/boardgame/${game.bgg_id}`}>BoardGameGeek ↗</a></>}</p>

    <div class="my-4 grid max-w-[46rem] gap-3" id="thread" aria-live="polite" data-i18n={chatStrings}>
      {(res || err) && (
        <div class={chat.turn} data-answer-id={res?.id ?? ''}>
          <div class={chat.q}>{q}</div>
          {err ? <Card className={chat.a}><CardContent><b>{err}</b></CardContent></Card> : res && (
            <Card className={chat.a} id="answer"><CardContent>
              <p class={chat.text}>{res.answer}</p>
              {res.warning && <p><Badge variant="danger">{t(L, 'chat.check')}</Badge> {res.warning}</p>}
              <small><Badge variant="warning">{t(L, 'chat.aiNote')}</Badge></small>
              {docs.length > 0 && (
                <ul class={chat.docs}>
                  {docs.map((d) => (
                    <li><small><a href={d.url}>{d.title}</a>{d.publisher && ` (${d.publisher})`}{d.pages.length > 0 && ` · ${pageList(d.pages)}`}{d.lang && ` · ${langTag(d.lang)}`}</small>
                      {d.quote && <details><summary><small>{t(L, 'chat.quote')}</small></summary><blockquote class={chat.quote} lang={d.lang ?? undefined}>“{d.quote}…”</blockquote></details>}
                    </li>
                  ))}
                </ul>
              )}
              {res.id && (
                <form method="post" action="/rate-answer" class={chat.vote} data-vote>
                  <input type="hidden" name="answer" value={res.id} />
                  <input type="hidden" name="next" value={nextUrl} />
                  <small>{t(L, 'chat.helpfulQ')}</small>
                  <Button variant="outline" name="vote" value="up" type="submit">{t(L, 'chat.helpful')}</Button>
                  <Button variant="outline" name="vote" value="down" type="submit">{t(L, 'chat.notHelpful')}</Button>
                  {voted && <small>{t(L, 'chat.voteSaved')}</small>}
                </form>
              )}
            </CardContent></Card>
          )}
        </div>
      )}
    </div>

    {!user ? (
      <Card className="max-w-md text-base"><CardContent>
        <p class="mt-0"><b>{t(L, 'chat.signInTitle')}</b> {t(L, 'chat.signInBody')}</p>
        <a data-slot="button" class={linkButton()} href={loginUrl}>{t(L, 'nav.signin')}</a>
      </CardContent></Card>
    ) : (
      <form id="ask-form" method="get" action={`/games/${slug}`} data-game={slug} data-max-turns={MAX_THREAD_TURNS} data-warn-turn={THREAD_WARN_TURN} class="my-4 flex max-w-[46rem] flex-wrap gap-2">
        <Input name="q" aria-label={t(L, 'chat.placeholder', { game: game.name })} placeholder={t(L, 'chat.placeholder', { game: game.name })} maxLength={300} minLength={3} required autoComplete="off" className="h-11 min-w-56 flex-1 bg-card px-3.5 text-[1.05rem] md:text-[1.05rem]" />
        <Button type="submit" className="h-11 px-4">{t(L, 'chat.ask')}</Button>
        <Button type="button" variant="secondary" id="chat-clear" className="h-11 px-4" hidden>{t(L, 'chat.newConversation')}</Button>
      </form>
    )}
    {user && <p id="chat-meter" class="-mt-2.5 mb-4 text-muted-foreground" hidden aria-live="polite"><small></small></p>}
    <p class="text-muted-foreground"><small>{t(L, 'chat.citesNote')}</small></p>

    <p class="flex flex-wrap gap-2">
      <a data-slot="button" class={linkButton()} href={`/games/${slug}/setup`}>{t(L, 'game.setup')}</a>
      <a data-slot="button" class={linkButton()} href={`/games/${slug}/aid`}>{t(L, 'game.aid')}</a>
      <a data-slot="button" class={linkButton('secondary')} href={`/games/${slug}/faq`}>{t(L, 'game.faq')}</a>
    </p>
    <div class="grid gap-4">
      {links.length > 0 && (
        <Card className="text-base" id="links">
          <CardHeader><CardTitle><h2 class="m-0 text-xl">{t(L, 'game.linksTitle')}</h2></CardTitle></CardHeader>
          <CardContent>
            <p class="mt-0 text-muted-foreground"><small>{t(L, 'game.linksNote')}</small></p>
            <ul class="mb-0">
              {links.map((c) => {
                const url = c.body.match(/https?:\/\/\S+(?=\s\()/)?.[0];
                return <li id={`c${c.id}`}>{url ? <a href={url} rel="noopener nofollow">{url}</a> : c.body} · <small>{c.locator} · <a href={c.source_url}>{c.source_title}</a></small></li>;
              })}
            </ul>
          </CardContent>
        </Card>
      )}
      <Card className="text-base" id="community">
        <CardHeader><CardTitle><h2 class="m-0 text-xl">{t(L, 'game.communityTitle')}</h2></CardTitle></CardHeader>
        <CardContent>
          <ul class="mt-0">
            {game.bgg_id && <li><a href={`https://boardgamegeek.com/boardgame/${game.bgg_id}/forums`} rel="noopener nofollow">{t(L, 'game.bggForums')}</a></li>}
            <li><a href={reddit} rel="noopener nofollow">{t(L, 'game.reddit')}</a></li>
          </ul>
          <p class="mb-0 text-muted-foreground"><small>{t(L, 'game.communityNote')}</small></p>
        </CardContent>
      </Card>
      {sources.length === 0 && <Card className="text-base"><CardContent><b>{t(L, 'game.noSourcesTitle')}</b> {t(L, 'game.noSourcesBody')} <a href="/about#publishers">{t(L, 'game.contactUs')}</a> {t(L, 'game.noSourcesEnd')}</CardContent></Card>}
    </div>
    {sources.length > 0 && <>
      <h2>{t(L, 'game.sourcesTitle')}</h2>
      <ul>{mainSources.map((s) => <li><a href={s.url}>{s.title ?? s.url}</a>{s.publisher && ` · ${s.publisher}`} · {t(L, 'common.edition', { edition: s.edition })}{s.language && ` · ${langTag(s.language)}`}{s.availability !== 'available' && ` · ${t(L, 'game.unavailable')}`}</li>)}
        {wikiGroups.filter((w) => w.pages.length > 0).map((w) => <li><details><summary>{t(L, w.key, { n: w.pages.length })}{w.pages[0]!.publisher && ` · ${w.pages[0]!.publisher}`}</summary>
          <ul>{w.pages.map((s) => <li><a href={s.url}>{s.title ?? s.url}</a>{s.availability !== 'available' && ` · ${t(L, 'game.unavailable')}`}</li>)}</ul>
        </details></li>)}
      </ul>
    </>}
    <p class="text-muted-foreground"><small>{t(L, 'game.rightsNote')}</small></p>
    <p class="text-muted-foreground"><small><a href={`/games/${slug}/facts`}>{t(L, 'game.factBase')}</a></small></p>
  </main>
  {/* Shadcn elements the chat script copies (tag, classes, data-slot; never their content), so turns it adds in the
      browser look exactly like the server-rendered answer above without the script hard-coding any class names. */}
  <template id="chat-ui">
    <div data-ui="turn" class={chat.turn}></div>
    <div data-ui="q" class={chat.q}></div>
    <Card data-ui="answer" className={chat.a}><CardContent data-ui="body" /></Card>
    <Card data-ui="thinking" className={chat.a}><CardContent data-ui="thinking-body" className={chat.thinking} /></Card>
    <span data-ui="spinner" class={chat.spinner}></span>
    <p data-ui="text" class={chat.text}></p>
    <Badge data-ui="check" variant="danger" />
    <Badge data-ui="ai" variant="warning" />
    <ul data-ui="docs" class={chat.docs}></ul>
    <blockquote data-ui="quote" class={chat.quote}></blockquote>
    <form data-ui="vote" class={chat.vote}></form>
    <Button data-ui="vote-button" variant="outline" />
    <a data-ui="signin" data-slot="button" class={linkButton()}></a>
  </template>
  <script is:inline>
    // Chat thread: asks go to /api/ask and answers are appended here, so earlier turns stay on screen.
    // The thread lives in page memory only: leaving or reloading the page clears it (Cory 2026-10-16). Nothing is stored in the browser or on the server.
    // Without JavaScript none of this runs and the form does a plain GET ?q= instead.
    (() => {
      const form = document.getElementById('ask-form');
      const thread = document.getElementById('thread');
      if (!form || !thread) return;
      const game = form.dataset.game;
      const KEY = `rogue-chat:${game}`;
      // Server limits (12 turns per thread, warning from turn 10). The server re-checks; this only keeps the UI honest.
      const MAX_TURNS = Number(form.dataset.maxTurns) || 12;
      const WARN_TURN = Number(form.dataset.warnTurn) || 10;
      const clearBtn = document.getElementById('chat-clear');
      const input = form.querySelector('input[name="q"]');
      const askBtn = form.querySelector('button[type="submit"]');
      const meter = document.getElementById('chat-meter');
      // UI strings in the page language, from the server (data-i18n on #thread); {name} placeholders are filled here.
      const S = JSON.parse(thread.dataset.i18n || '{}');
      const tr = (k, v) => (S[k] || k).replace(/\{(\w+)\}/g, (m, n) => (v && n in v ? String(v[n]) : m));

      window.addEventListener("pageshow", (e) => { if (e.persisted) location.reload(); }); // back button must not resurrect an old thread
      let memory = [];
      const load = () => memory;
      const save = (turns) => { memory = turns.slice(-MAX_TURNS); };

      // Small DOM builder; text always goes in via textContent, never as HTML.
      function fill(n, props, kids) {
        for (const [k, v] of Object.entries(props)) {
          if (k === 'text') n.textContent = v; else n.setAttribute(k, v);
        }
        for (const k of kids) if (k) n.append(k);
        return n;
      }
      const el = (tag, props = {}, ...kids) => fill(document.createElement(tag), props, kids);
      // Styled parts are empty copies of the shadcn elements in <template id="chat-ui"> (same tag, classes, data-slot).
      const KIT = {};
      for (const n of document.getElementById('chat-ui').content.querySelectorAll('[data-ui]')) KIT[n.dataset.ui] = n;
      function ui(name, props = {}, ...kids) {
        const n = KIT[name].cloneNode(false);
        n.removeAttribute('data-ui');
        return fill(n, props, kids);
      }
      // A card with its content box; kids go into the content box.
      const card = (name, ...kids) => ui(name, {}, ui(name === 'thinking' ? 'thinking-body' : 'body', {}, ...kids));
      const safeUrl = (u) => (/^https?:\/\//.test(u) ? u : '#');

      function answerCard(t) {
        if (t.error) return card('answer', el('b', { text: t.error }), t.signIn ? el('p', {}, ui('signin', { href: `/login?next=${encodeURIComponent(location.pathname)}`, text: tr('nav.signin') })) : null);
        const out = card('answer', ui('text', { text: t.answer }));
        const body = out.firstChild;
        if (t.warning) body.append(el('p', {}, ui('check', { text: tr('chat.check') }), ` ${t.warning}`));
        body.append(el('small', {}, ui('ai', { text: tr('chat.aiNote') })));
        if (t.docs && t.docs.length) {
          const ul = ui('docs');
          for (const d of t.docs) {
            const line = el('small', {}, el('a', { href: safeUrl(d.url), text: d.title }), d.publisher ? ` (${d.publisher})` : '', d.cite ? ` · ${d.cite}` : '', d.tag ? ` · ${d.tag}` : '');
            const quote = d.quote ? el('details', {}, el('summary', {}, el('small', { text: tr('chat.quote') })), ui('quote', d.lang ? { lang: d.lang, text: `“${d.quote}…”` } : { text: `“${d.quote}…”` })) : null;
            ul.append(el('li', {}, line, quote));
          }
          body.append(ul);
        }
        if (t.id) {
          const vote = ui('vote', { method: 'post', action: '/rate-answer', 'data-vote': '' },
            el('input', { type: 'hidden', name: 'answer', value: String(t.id) }),
            el('input', { type: 'hidden', name: 'next', value: `/games/${game}?q=${encodeURIComponent(t.q)}` }),
            el('small', { text: tr('chat.helpfulQ') }),
            ui('vote-button', { name: 'vote', value: 'up', type: 'submit', text: tr('chat.helpful') }),
            ui('vote-button', { name: 'vote', value: 'down', type: 'submit', text: tr('chat.notHelpful') }));
          body.append(vote);
        }
        return out;
      }

      // Shows the thread size as turns (what the limit counts), warns near the end, and locks the box at the limit.
      function updateMeter(full) {
        const n = load().length;
        const atLimit = full || n >= MAX_TURNS;
        input.disabled = atLimit;
        if (askBtn) askBtn.disabled = atLimit;
        if (clearBtn) clearBtn.textContent = atLimit ? tr('chat.startNew') : tr('chat.newConversation');
        if (!meter) return;
        meter.hidden = n === 0 && !atLimit;
        const text = meter.querySelector('small');
        if (atLimit) text.textContent = tr('chat.meterFull', { n: Math.min(n, MAX_TURNS), max: MAX_TURNS });
        else if (n + 1 >= WARN_TURN) text.textContent = tr('chat.meterWarn', { n: n + 1, max: MAX_TURNS });
        else text.textContent = tr('chat.meter', { n: n + 1, max: MAX_TURNS });
      }

      function addTurn(t) {
        const turn = ui('turn', { 'data-answer-id': t.id ? String(t.id) : '' }, ui('q', { text: t.q }));
        let thinking = null;
        if (t.pending) {
          thinking = card('thinking', ui('spinner', { 'aria-hidden': 'true' }), el('span', { text: tr('chat.thinking') }));
          thinking.setAttribute('role', 'status');
        }
        turn.append(thinking || answerCard(t));
        thread.append(turn);
        if (clearBtn) clearBtn.hidden = false;
        return turn;
      }

      // Earlier turns go above a server-rendered answer (?q=), skipping it if it is the same answer.
      const serverTurn = thread.querySelector('[data-answer-id]'); // every turn carries data-answer-id
      const serverId = serverTurn ? serverTurn.dataset.answerId : '';
      for (const t of load()) {
        if (serverId && String(t.id) === serverId) continue;
        const n = addTurn(t);
        if (serverTurn) thread.insertBefore(n, serverTurn);
      }
      if (serverTurn && clearBtn) clearBtn.hidden = false;
      updateMeter(false);

      // The box clears at once and the button stays usable: questions typed while an answer is loading wait in a queue and
      // are sent one at a time, so each follow-up can see the answer before it (Cory 2026-10-16).
      const queue = []; let working = false; let stopped = false; let gen = 0;
      async function work() {
        if (working) return; working = true;
        while (queue.length) {
          const { q, turn, g } = queue.shift();
          if (g !== gen) continue; // thread was cleared while this was waiting
          if (stopped) { turn.replaceWith(addTurn({ q, error: tr('chat.fullError') })); continue; }
          let t; let full = false;
          const prior = load().map((x) => ({ q: x.q, a: x.answer || '' }));
          // aria-busy holds back screen-reader announcements of the live thread until the answer is in place.
          thread.setAttribute('aria-busy', 'true');
          try {
            const r = await fetch('/api/ask', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ game, q, history: prior }) });
            const body = await r.json().catch(() => ({}));
            if (body.limit) { t = { q, error: body.message }; full = body.limit === 'thread'; }
            else t = r.ok ? { q, id: body.id, answer: body.answer, warning: body.warning, docs: body.docs } : { q, error: body.error || tr('chat.genericError'), signIn: r.status === 401 };
          } catch {
            t = { q, error: tr('chat.offline') };
          }
          thread.removeAttribute('aria-busy');
          if (g !== gen) continue;
          turn.replaceWith(addTurn(t));
          if (!t.error) save([...load(), t]);
          if (full) stopped = true;
          updateMeter(full);
        }
        working = false;
        if (!input.disabled) input.focus(); else if (clearBtn) clearBtn.focus();
      }
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const q = input.value.trim();
        if (q.length < 3 || stopped) return;
        input.value = ''; // clear straight away so the next question can be typed while this one loads
        const turn = addTurn({ q, pending: true });
        const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
        turn.scrollIntoView({ behavior: calm ? 'auto' : 'smooth', block: 'nearest' });
        queue.push({ q, turn, g: gen });
        work();
      });

      // Votes are sent in the background so the thread is not reloaded (rate-answer answers with a redirect).
      thread.addEventListener('submit', async (e) => {
        const vote = e.target;
        if (!(vote instanceof HTMLFormElement) || !('vote' in vote.dataset)) return;
        e.preventDefault();
        const data = new FormData(vote, e.submitter);
        for (const b of vote.querySelectorAll('button')) b.disabled = true;
        let msg = tr('chat.voteSaved');
        try {
          const r = await fetch(vote.action, { method: 'POST', body: data, redirect: 'manual' });
          if (r.type !== 'opaqueredirect' && !r.ok) msg = r.status === 429 ? tr('chat.voteTooMany') : tr('chat.voteFailed');
        } catch { msg = tr('chat.voteFailed'); }
        for (const s of vote.querySelectorAll('[data-vote-msg]')) s.remove();
        vote.append(el('small', { 'data-vote-msg': '', text: msg }));
        for (const b of vote.querySelectorAll('button')) b.disabled = false;
      });

      if (clearBtn) clearBtn.addEventListener('click', () => {
        memory = []; queue.length = 0; stopped = false; gen++;
        thread.replaceChildren();
        clearBtn.hidden = true;
        if (location.search) history.replaceState(null, '', location.pathname);
        updateMeter(false);
        input.focus();
      });
    })();
  </script>
</Base>
