---
import Base from '../../../layouts/Base.astro';
import { getGame, getClaims } from '../../../lib/kb';
import { askRules, gameSources, spendChatBudget, type ChatAnswer } from '../../../lib/chat';
import { recordAsk } from '../../../lib/unanswered';
import { MAX_THREAD_TURNS, THREAD_WARN_TURN, groupCitations, pageList } from '@rogue/core';
const { slug } = Astro.params;
const game = await getGame(slug!);
if (!game) return new Response('Not found', { status: 404 });
const user = Astro.locals.user;
// The game page is a chat (Cory 2026-10-16). The fact list lives on /games/<slug>/facts; here we only need companion links and documents.
const links = await getClaims(slug!, { topic: 'companion' });
const sources = await gameSources(slug!);
// Without JavaScript the ask box is a plain GET form: ?q= renders that one answer here.
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const voted = Astro.url.searchParams.get('voted');
const nextUrl = `/games/${slug}?q=${encodeURIComponent(q)}`;
let res: ChatAnswer | null = null; let err = '';
if (user && q.length >= 3) {
  // A single question without history (no-JS form). The page reloads after a vote; that is not a new ask, so it is not counted again.
  const budget = voted ? null : spendChatBudget(user, 0);
  if (budget && !budget.ok) err = budget.message;
  else {
    try { res = await askRules(slug!, q); } catch (e) { err = 'The rules assistant is busy or offline. Please try again in a minute.'; console.warn('[ask]', (e as Error).message); }
    if (!voted) recordAsk(slug!, q, 'web', res ?? { error: err });
  }
}
const docs = res ? groupCitations(res.sources) : [];
const loginUrl = `/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;
const reddit = `https://www.reddit.com/search/?q=${encodeURIComponent(`${game.name} board game rules`)}`;
---
<Base title={game.name}>
  <style>
    .thread { display: grid; gap: .8rem; margin: 1rem 0; max-width: 46rem }
    .turn { display: grid; gap: .4rem }
    .q-bubble { justify-self: end; max-width: 85%; background: #cdbf9b; color: #222; padding: .55rem .85rem; border-radius: 14px 14px 2px 14px; white-space: pre-line }
    .a-bubble { max-width: 92%; margin: 0; border-radius: 14px 14px 14px 2px }
    .a-text { font-size: 1.05rem; margin-top: 0; white-space: pre-line }
    .a-docs { margin: .5rem 0 0; padding-left: 1.1rem }
    .a-docs blockquote { margin: .3rem 0 0; opacity: .8; font-size: .9rem }
    .vote { margin-top: .8rem; display: flex; gap: .5rem; align-items: center; flex-wrap: wrap }
    .thinking { display: flex; gap: .6rem; align-items: center }
    .spinner { width: 1rem; height: 1rem; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: spin .8s linear infinite; flex: none }
    @keyframes spin { to { transform: rotate(360deg) } }
    @media (prefers-reduced-motion: reduce) { .spinner { animation-duration: 2.4s } }
    #chat-meter { margin: -.6rem 0 1rem; opacity: .8 }
  </style>
  <main>
    <h1>{game.name}</h1>
    <p>{game.publisher} · {game.year} · {game.min_players}–{game.max_players} players {game.bgg_id && <>· <a href={`https://boardgamegeek.com/boardgame/${game.bgg_id}`}>BoardGameGeek ↗</a></>}</p>

    <div class="thread" id="thread" aria-live="polite">
      {(res || err) && (
        <div class="turn" data-answer-id={res?.id ?? ''}>
          <div class="q-bubble">{q}</div>
          {err ? <div class="card a-bubble"><b>{err}</b></div> : res && (
            <div class="card a-bubble" id="answer">
              <p class="a-text">{res.answer}</p>
              {res.warning && <p><span class="pill bad">check</span> {res.warning}</p>}
              <small><span class="pill warn">AI answer from the publisher rulebook, can be wrong</span></small>
              {docs.length > 0 && (
                <ul class="a-docs">
                  {docs.map((d) => (
                    <li><small><a href={d.url}>{d.title}</a>{d.publisher && ` (${d.publisher})`}{d.pages.length > 0 && ` · ${pageList(d.pages)}`}</small>
                      {d.quote && <details><summary><small>Quote</small></summary><blockquote>“{d.quote}…”</blockquote></details>}
                    </li>
                  ))}
                </ul>
              )}
              {res.id && (
                <form method="post" action="/rate-answer" class="vote" data-vote>
                  <input type="hidden" name="answer" value={res.id} />
                  <input type="hidden" name="next" value={nextUrl} />
                  <small>Was this helpful?</small>
                  <button class="btn" name="vote" value="up" type="submit" style="border:0;cursor:pointer">👍 Helpful</button>
                  <button class="btn" name="vote" value="down" type="submit" style="border:0;cursor:pointer">👎 Not helpful</button>
                  {voted && <small>Thanks, vote saved.</small>}
                </form>
              )}
            </div>
          )}
        </div>
      )}
    </div>

    {!user ? (
      <div class="card" style="max-width:28rem"><p style="margin-top:0"><b>Sign in to ask the rules assistant.</b> It uses AI compute, so it is for signed-in players. Setup sheets stay open to everyone.</p><a class="btn" href={loginUrl}>Sign in</a></div>
    ) : (
      <form id="ask-form" method="get" action={`/games/${slug}`} data-game={slug} data-max-turns={MAX_THREAD_TURNS} data-warn-turn={THREAD_WARN_TURN} style="margin:1rem 0;display:flex;gap:.5rem;flex-wrap:wrap;max-width:46rem">
        <input name="q" placeholder={`Ask anything about ${game.name}…`} maxlength="300" minlength="3" required autocomplete="off" style="padding:.7rem .9rem;font-size:1.05rem;flex:1;min-width:14rem;border-radius:8px;border:0" />
        <button class="btn" type="submit" style="border:0;cursor:pointer">Ask</button>
        <button class="btn" type="button" id="chat-clear" hidden style="border:0;cursor:pointer;background:#cdbf9b">New conversation</button>
      </form>
    )}
    {user && <p id="chat-meter" hidden aria-live="polite"><small></small></p>}
    <p><small style="opacity:.8">Every answer cites the publisher's rulebook page.</small></p>

    <p><a class="btn" href={`/games/${slug}/setup`}>Setup one-pager</a> <a class="btn" href={`/games/${slug}/aid`}>Player aid</a> <a class="btn" href={`/games/${slug}/faq`} style="background:#cdbf9b">Common questions</a></p>
    {links.length > 0 && (
      <div class="card" id="links">
        <h2 style="margin-top:0">Companion app and links</h2>
        <p style="opacity:.8"><small>QR codes printed in the publisher's rulebook. We only list the link; check the address before you open it.</small></p>
        <ul>
          {links.map((c) => {
            const url = c.body.match(/https?:\/\/\S+(?=\s\()/)?.[0];
            return <li id={`c${c.id}`}>{url ? <a href={url} rel="noopener nofollow">{url}</a> : c.body} · <small>{c.locator} of <a href={c.source_url}>{c.source_title}</a></small></li>;
          })}
        </ul>
      </div>
    )}
    <div class="card" id="community">
      <h2 style="margin-top:0">More community discussion</h2>
      <ul>
        {game.bgg_id && <li><a href={`https://boardgamegeek.com/boardgame/${game.bgg_id}/forums`} rel="noopener nofollow">BoardGameGeek forums ↗</a></li>}
        <li><a href={reddit} rel="noopener nofollow">Search Reddit for rules discussion ↗</a></li>
      </ul>
      <p style="opacity:.8;margin-bottom:0"><small>We do not read or copy these sites; links only.</small></p>
    </div>
    {sources.length === 0 && <div class="card"><b>No sources yet.</b> We have not ingested an official source for this game. If you are the publisher, you can <a href="/about#publishers">contact us</a> to authorise one.</div>}
    {sources.length > 0 && <>
      <h2>Sources</h2>
      <ul>{sources.map((s) => <li><a href={s.url}>{s.title ?? s.url}</a>{s.publisher && ` · ${s.publisher}`} · edition: {s.edition}{s.availability !== 'available' && ' · no longer available'}</li>)}</ul>
    </>}
    <p style="opacity:.7"><small>We link to the publisher's file and quote only short passages. We do not host rulebooks. Rules chat needs a free sign-in (GitHub, Google or Discord).</small></p>
    <p style="opacity:.6"><small><a href={`/games/${slug}/facts`}>Browse the fact base</a></small></p>
  </main>
  <script is:inline>
    // Chat thread: asks go to /api/ask and answers are appended here, so earlier turns stay on screen.
    // The last turns are kept in sessionStorage (this tab only; nothing new is stored on the server).
    // Without JavaScript none of this runs and the form does a plain GET ?q= instead.
    (() => {
      const form = document.getElementById('ask-form');
      const thread = document.getElementById('thread');
      if (!form || !thread) return;
      const game = form.dataset.game;
      const KEY = `rogue-chat:${game}`;
      // Server limits (12 turns per thread, warning from turn 10). The server re-checks; this only keeps the UI honest.
      const MAX_TURNS = Number(form.dataset.maxTurns) || 12;
      const WARN_TURN = Number(form.dataset.warnTurn) || 10;
      const clearBtn = document.getElementById('chat-clear');
      const input = form.querySelector('input[name="q"]');
      const askBtn = form.querySelector('button[type="submit"]');
      const meter = document.getElementById('chat-meter');

      const load = () => { try { return JSON.parse(sessionStorage.getItem(KEY) || '[]'); } catch { return []; } };
      const save = (turns) => { try { sessionStorage.setItem(KEY, JSON.stringify(turns.slice(-MAX_TURNS))); } catch { /* storage full or blocked: thread just won't survive a reload */ } };

      // Small DOM builder; text always goes in via textContent, never as HTML.
      function el(tag, props = {}, ...kids) {
        const n = document.createElement(tag);
        for (const [k, v] of Object.entries(props)) {
          if (k === 'class') n.className = v; else if (k === 'text') n.textContent = v; else n.setAttribute(k, v);
        }
        for (const k of kids) if (k) n.append(k);
        return n;
      }
      const safeUrl = (u) => (/^https?:\/\//.test(u) ? u : '#');

      function answerCard(t) {
        if (t.error) return el('div', { class: 'card a-bubble' }, el('b', { text: t.error }), t.signIn ? el('p', {}, el('a', { class: 'btn', href: `/login?next=${encodeURIComponent(location.pathname)}`, text: 'Sign in' })) : null);
        const card = el('div', { class: 'card a-bubble' }, el('p', { class: 'a-text', text: t.answer }));
        if (t.warning) card.append(el('p', {}, el('span', { class: 'pill bad', text: 'check' }), ` ${t.warning}`));
        card.append(el('small', {}, el('span', { class: 'pill warn', text: 'AI answer from the publisher rulebook, can be wrong' })));
        if (t.docs && t.docs.length) {
          const ul = el('ul', { class: 'a-docs' });
          for (const d of t.docs) {
            const line = el('small', {}, el('a', { href: safeUrl(d.url), text: d.title }), d.publisher ? ` (${d.publisher})` : '', d.cite ? ` · ${d.cite}` : '');
            const quote = d.quote ? el('details', {}, el('summary', {}, el('small', { text: 'Quote' })), el('blockquote', { text: `“${d.quote}…”` })) : null;
            ul.append(el('li', {}, line, quote));
          }
          card.append(ul);
        }
        if (t.id) {
          const vote = el('form', { method: 'post', action: '/rate-answer', class: 'vote', 'data-vote': '' },
            el('input', { type: 'hidden', name: 'answer', value: String(t.id) }),
            el('input', { type: 'hidden', name: 'next', value: `/games/${game}?q=${encodeURIComponent(t.q)}` }),
            el('small', { text: 'Was this helpful?' }),
            el('button', { class: 'btn', name: 'vote', value: 'up', type: 'submit', style: 'border:0;cursor:pointer', text: '👍 Helpful' }),
            el('button', { class: 'btn', name: 'vote', value: 'down', type: 'submit', style: 'border:0;cursor:pointer', text: '👎 Not helpful' }));
          card.append(vote);
        }
        return card;
      }

      // Shows the thread size as turns (what the limit counts), warns near the end, and locks the box at the limit.
      function updateMeter(full) {
        const n = load().length;
        const atLimit = full || n >= MAX_TURNS;
        input.disabled = atLimit;
        if (askBtn) askBtn.disabled = atLimit;
        if (clearBtn) clearBtn.textContent = atLimit ? 'Start new conversation' : 'New conversation';
        if (!meter) return;
        meter.hidden = n === 0 && !atLimit;
        const text = meter.querySelector('small');
        if (atLimit) text.textContent = `Turn ${Math.min(n, MAX_TURNS)} of ${MAX_TURNS}. This conversation is full; start a new one to keep asking.`;
        else if (n + 1 >= WARN_TURN) text.textContent = `Turn ${n + 1} of ${MAX_TURNS}. Nearly full: answers stay most accurate in a fresh conversation.`;
        else text.textContent = `Turn ${n + 1} of ${MAX_TURNS}`;
      }

      function addTurn(t) {
        const turn = el('div', { class: 'turn', 'data-answer-id': t.id ? String(t.id) : '' }, el('div', { class: 'q-bubble', text: t.q }));
        turn.append(t.pending
          ? el('div', { class: 'card a-bubble thinking', role: 'status' }, el('span', { class: 'spinner', 'aria-hidden': 'true' }), el('span', { text: 'Looking it up in the rulebook…' }))
          : answerCard(t));
        thread.append(turn);
        if (clearBtn) clearBtn.hidden = false;
        return turn;
      }

      // Earlier turns go above a server-rendered answer (?q=), skipping it if it is the same answer.
      const serverTurn = thread.querySelector('.turn');
      const serverId = serverTurn ? serverTurn.dataset.answerId : '';
      for (const t of load()) {
        if (serverId && String(t.id) === serverId) continue;
        const n = addTurn(t);
        if (serverTurn) thread.insertBefore(n, serverTurn);
      }
      if (serverTurn && clearBtn) clearBtn.hidden = false;
      updateMeter(false);

      form.addEventListener('submit', async (e) => {
        e.preventDefault(); // we handle it; Base.astro's busy guard skips prevented submits, so set it ourselves
        const q = input.value.trim();
        if (q.length < 3 || form.getAttribute('aria-busy') === 'true') return;
        window.RogueBusy && window.RogueBusy.set(form, e.submitter);
        const turn = addTurn({ q, pending: true });
        turn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        let t; let full = false;
        // Earlier answered turns go along so follow-ups ("and the medic?") make sense; the server clamps and trims them.
        const prior = load().map((x) => ({ q: x.q, a: x.answer || '' }));
        try {
          const r = await fetch('/api/ask', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ game, q, history: prior }) });
          const body = await r.json().catch(() => ({}));
          if (body.limit) { t = { q, error: body.message }; full = body.limit === 'thread'; }
          else t = r.ok ? { q, id: body.id, answer: body.answer, warning: body.warning, docs: body.docs } : { q, error: body.error || 'Something went wrong. Please try again.', signIn: r.status === 401 };
        } catch {
          t = { q, error: 'Could not reach the rules assistant. Check your connection and try again.' };
        }
        turn.replaceWith(addTurn(t));
        if (!t.error) { save([...load(), t]); input.value = ''; }
        window.RogueBusy && window.RogueBusy.clear(form);
        updateMeter(full);
        if (!input.disabled) input.focus(); else if (clearBtn) clearBtn.focus();
      });

      // Votes are sent in the background so the thread is not reloaded (rate-answer answers with a redirect).
      thread.addEventListener('submit', async (e) => {
        const vote = e.target;
        if (!(vote instanceof HTMLFormElement) || !('vote' in vote.dataset)) return;
        e.preventDefault();
        const data = new FormData(vote, e.submitter);
        for (const b of vote.querySelectorAll('button')) b.disabled = true;
        let msg = 'Thanks, vote saved.';
        try {
          const r = await fetch(vote.action, { method: 'POST', body: data, redirect: 'manual' });
          if (r.type !== 'opaqueredirect' && !r.ok) msg = r.status === 429 ? 'Too many votes, slow down.' : 'Could not save the vote.';
        } catch { msg = 'Could not save the vote.'; }
        for (const s of vote.querySelectorAll('[data-vote-msg]')) s.remove();
        vote.append(el('small', { 'data-vote-msg': '', text: msg }));
        for (const b of vote.querySelectorAll('button')) b.disabled = false;
      });

      if (clearBtn) clearBtn.addEventListener('click', () => {
        sessionStorage.removeItem(KEY);
        thread.replaceChildren();
        clearBtn.hidden = true;
        if (location.search) history.replaceState(null, '', location.pathname);
        updateMeter(false);
        input.focus();
      });
    })();
  </script>
</Base>
