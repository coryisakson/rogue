---
import Base from '../../layouts/Base.astro';
import { listPopularGames } from '../../lib/kb';
import { clientStrings, t } from '@rogue/core';
const L = Astro.locals.locale;
const games = await listPopularGames();
const POPULAR = 6; // shown without scrolling; everything else is reached by typing
const data = games.map((g) => ({ slug: g.slug, name: g.name, publisher: g.publisher, year: g.year, players: t(L, 'common.players', { min: g.min_players, max: g.max_players }), ready: g.claim_count > 0 }));
// Strings for the search script below; {n}/{term} are filled in the browser, numbers with Intl in the page language.
const strings = JSON.stringify({ ...clientStrings(L, ['games.popular', 'games.ready', 'games.noSources', 'games.matchOne', 'games.matchMany', 'games.missing']), locale: L });
---
<Base title={t(L, 'games.title')}>
  <main>
    <h1>{t(L, 'games.title')}</h1>
    <label for="gs" class="sr-only" style="position:absolute;left:-9999px">{t(L, 'games.search')}</label>
    <input id="gs" type="search" placeholder={t(L, 'games.placeholder')} autocomplete="off" data-i18n={strings} style="width:100%;max-width:36rem;padding:.6rem .8rem;font-size:1.05rem" />
    <p id="gs-count" aria-live="polite" style="margin:.4rem 0"><small>{t(L, 'games.popular')}</small></p>
    <div id="gs-grid" class="grid">
      {data.slice(0, POPULAR).map((g) => (
        <div class="card">
          <h3 style="margin:.1rem 0"><a href={`/games/${g.slug}`}>{g.name}</a></h3>
          <div>{g.publisher} · {g.year} · {g.players}</div>
          <p>{g.ready ? <span class="pill ok">{t(L, 'games.ready')}</span> : <span class="pill">{t(L, 'games.noSources')}</span>}</p>
        </div>
      ))}
    </div>
    <div id="gs-missing" class="card" hidden style="margin-top:1rem">
      <b id="gs-term"></b>
      <p style="margin:.4rem 0">{t(L, 'games.wantIt')} <a id="gs-link" href="/request-game">{t(L, 'games.requestThis')}</a> {t(L, 'games.requestNote')}</p>
    </div>
    <p id="gs-foot" style="margin-top:1.5rem">{t(L, 'games.missingFoot')} <a href="/request-game">{t(L, 'games.requestIt')}</a>.</p>
  </main>
  <script type="application/json" id="gs-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')}></script>
  <script is:inline>
    (function () {
      var all = JSON.parse(document.getElementById('gs-data').textContent);
      var input = document.getElementById('gs'), grid = document.getElementById('gs-grid'), count = document.getElementById('gs-count');
      var missing = document.getElementById('gs-missing'), term = document.getElementById('gs-term'), link = document.getElementById('gs-link'), foot = document.getElementById('gs-foot');
      var S = JSON.parse(input.dataset.i18n || '{}');
      var POPULAR = 6;
      function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
      function norm(s) { return String(s).toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9 ]+/g, ' ').replace(/\s+/g, ' ').trim(); }
      function card(g) {
        return '<div class="card"><h3 style="margin:.1rem 0"><a href="/games/' + encodeURIComponent(g.slug) + '">' + esc(g.name) + '</a></h3><div>' + esc(g.publisher) + ' · ' + esc(g.year) + ' · ' + esc(g.players) + '</div><p>' +
          (g.ready ? '<span class="pill ok">' + esc(S['games.ready']) + '</span>' : '<span class="pill">' + esc(S['games.noSources']) + '</span>') + '</p></div>';
      }
      function render() {
        var raw = input.value.replace(/\s+/g, ' ').trim(), q = norm(raw);
        if (!q) { grid.innerHTML = all.slice(0, POPULAR).map(card).join(''); count.innerHTML = '<small>' + esc(S['games.popular']) + '</small>'; missing.hidden = true; foot.hidden = false; return; }
        var words = q.split(' ');
        var hits = all.filter(function (g) { var hay = norm(g.name + ' ' + (g.publisher || '')); return words.every(function (w) { return hay.indexOf(w) !== -1; }); });
        hits.sort(function (a, b) { return Number(norm(b.name).indexOf(q) === 0) - Number(norm(a.name).indexOf(q) === 0); });
        grid.innerHTML = hits.map(card).join('');
        var n = new Intl.NumberFormat(S.locale).format(hits.length);
        count.innerHTML = '<small>' + esc((hits.length === 1 ? S['games.matchOne'] : S['games.matchMany']).replace('{n}', n)) + '</small>';
        missing.hidden = hits.length > 0; foot.hidden = hits.length === 0;
        if (!hits.length) { term.textContent = S['games.missing'].replace('{term}', '“' + raw + '”'); link.href = '/request-game?q=' + encodeURIComponent(raw.slice(0, 80)); }
      }
      input.addEventListener('input', render);
    })();
  </script>
</Base>
