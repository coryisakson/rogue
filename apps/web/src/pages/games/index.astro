---
import Base from '../../layouts/Base.astro';
import { listGames } from '../../lib/kb';
const games = await listGames();
---
<Base title="Games">
  <main>
    <h1>Games</h1>
    <div class="grid">
      {games.map((g) => (
        <div class="card">
          <h3 style="margin:.1rem 0"><a href={`/games/${g.slug}`}>{g.name}</a></h3>
          <div>{g.publisher} · {g.year} · {g.min_players}–{g.max_players} players</div>
          <p>{g.claim_count > 0 ? <span class="pill ok">{g.claim_count} cited facts</span> : <span class="pill">no sources ingested yet</span>}</p>
        </div>
      ))}
    </div>
    <p style="margin-top:1.5rem">Missing a game? <a href="/request-game">Request it</a> (sign in, publisher rulebook link, admin approves).</p>
  </main>
</Base>
