---
import Base from '../layouts/Base.astro';
import { safeNext, t } from '@rogue/core';
import { configuredProviders } from '../lib/auth';
import { PROVIDERS } from '@rogue/core';
const L = Astro.locals.locale;
const next = safeNext(Astro.url.searchParams.get('next'));
const err = Astro.url.searchParams.get('error');
const configured = Object.keys(configuredProviders());
---
<Base title={t(L, 'nav.signin')}>
  <main>
    <h1>{t(L, 'nav.signin')}</h1>
    <div class="card" style="max-width:26rem">
      <p style="margin-top:0">{t(L, 'login.intro')}</p>
      {err && <p><span class="pill bad">{t(L, 'login.failed')}</span> {t(L, 'login.tryAgain')}</p>}
      {Astro.locals.user ? <p>{t(L, 'login.signedInAs', { name: Astro.locals.user.name })} <a href={next}>{t(L, 'login.continue')}</a></p> : configured.length === 0 ? (
        <p><span class="pill warn">{t(L, 'login.notConfigured')}</span> {t(L, 'login.noProviders')}</p>
      ) : (
        <div style="display:grid;gap:.6rem">
          {configured.map((id) => <a class="btn" href={`/auth/${id}?next=${encodeURIComponent(next)}`}>{t(L, 'login.continueWith', { provider: PROVIDERS[id as keyof typeof PROVIDERS].label })}</a>)}
        </div>
      )}
      <p style="opacity:.7"><small>{t(L, 'login.privacy')}</small></p>
    </div>
  </main>
</Base>
