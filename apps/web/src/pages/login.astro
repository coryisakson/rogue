---
import Base from '../layouts/Base.astro';
import { safeNext, t } from '@rogue/core';
import { configuredProviders } from '../lib/auth';
import { PROVIDERS } from '@rogue/core';
import { Badge } from '../components/ui/badge';
import { buttonVariants } from '../components/ui/button';
import { Card, CardContent } from '../components/ui/card';
const L = Astro.locals.locale;
const next = safeNext(Astro.url.searchParams.get('next'));
const err = Astro.url.searchParams.get('error');
const configured = Object.keys(configuredProviders());
---
<Base title={t(L, 'nav.signin')}>
  <main id="main">
    <h1>{t(L, 'nav.signin')}</h1>
    <Card className="max-w-md text-base"><CardContent>
      <p class="mt-0">{t(L, 'login.intro')}</p>
      {err && <p><Badge variant="danger">{t(L, 'login.failed')}</Badge> {t(L, 'login.tryAgain')}</p>}
      {Astro.locals.user ? <p>{t(L, 'login.signedInAs', { name: Astro.locals.user.name })} <a href={next}>{t(L, 'login.continue')}</a></p> : configured.length === 0 ? (
        <p><Badge variant="warning">{t(L, 'login.notConfigured')}</Badge> {t(L, 'login.noProviders')}</p>
      ) : (
        <div class="grid gap-2.5">
          {configured.map((id) => <a data-slot="button" class={buttonVariants({ size: 'lg' })} href={`/auth/${id}?next=${encodeURIComponent(next)}`}>{t(L, 'login.continueWith', { provider: PROVIDERS[id as keyof typeof PROVIDERS].label })}</a>)}
        </div>
      )}
      <p class="mb-0 text-muted-foreground"><small>{t(L, 'login.privacy')}</small></p>
    </CardContent></Card>
  </main>
</Base>
