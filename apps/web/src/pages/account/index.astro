---
import Base from '../../layouts/Base.astro';
import { LANGUAGE_NAMES, LOCALES, PROVIDERS, t } from '@rogue/core';
import { configuredProviders, identitiesOf } from '../../lib/auth';
import { Badge } from '../../components/ui/badge';
import { Button } from '../../components/ui/button';
import { Card, CardContent } from '../../components/ui/card';
import { NativeSelect, NativeSelectOption } from '../../components/ui/native-select';
const L = Astro.locals.locale;
const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?next=/account');
const linked = user ? await identitiesOf(user.id) : [];
const available = Object.keys(configuredProviders());
const note = Astro.url.searchParams.get('linked');
const langSaved = Astro.url.searchParams.has('lang');
---
<Base title={t(L, 'account.title')}>
  <main id="main">
    <h1>{t(L, 'account.title')}</h1>
    <Card className="max-w-[30rem] text-base"><CardContent>
      <p class="mt-0">{t(L, 'account.signedInVia', { name: user.name, provider: user.provider })}</p>
      <p>{t(L, 'account.stored')}</p>
      {note && <p><Badge variant="secondary">{note === 'merged' ? t(L, 'account.merged') : note === 'already' ? t(L, 'account.already') : t(L, 'account.linked')}</Badge></p>}
      <h2>{t(L, 'account.languageTitle')}</h2>
      <p>{t(L, 'account.languageBody')}</p>
      <form method="post" action="/account/language" class="flex flex-wrap items-center gap-2">
        <input type="hidden" name="next" value="/account?lang=saved" />
        <label for="account-lang" class="sr-only">{t(L, 'lang.label')}</label>
        <NativeSelect id="account-lang" name="lang" defaultValue={L}>{LOCALES.map((l) => <NativeSelectOption value={l} lang={l}>{LANGUAGE_NAMES[l]}</NativeSelectOption>)}</NativeSelect>
        <Button type="submit">{t(L, 'lang.change')}</Button>
        {langSaved && <small>{t(L, 'account.languageSaved')}</small>}
      </form>
      <h2>{t(L, 'account.collectionTitle')}</h2>
      <p>{t(L, 'account.collectionBody')} <a href="/account/collection">{t(L, 'account.collectionLink')}</a></p>
      <h2>{t(L, 'account.methods')}</h2>
      <p>{t(L, 'account.discordNote')}</p>
      <p>{t(L, 'account.sameAccount')}</p>
      <ul>{available.map((id) => (
        <li>{PROVIDERS[id as keyof typeof PROVIDERS].label}: {linked.includes(id) ? <b>{t(L, 'account.linked')}</b> : <a href={`/auth/${id}?link=1&next=/account`}>{t(L, 'account.linkIt')}</a>}</li>
      ))}</ul>
      <h2>{t(L, 'account.deleteTitle')}</h2>
      <p>{t(L, 'account.deleteBody')}</p>
      <form method="post" action="/account/delete">
        <label class="flex items-center gap-2"><input type="checkbox" name="confirm" value="yes" required class="size-4 accent-primary" /> {t(L, 'account.deleteConfirm')}</label>
        <p class="mb-0"><Button type="submit">{t(L, 'account.deleteButton')}</Button></p>
      </form>
    </CardContent></Card>
  </main>
</Base>
