---
// Admin search box over every game in Rogue, also games without sources yet (lib/admin-games.ts allGames + searchGames in core).
// Every admin search outside /admin/requests uses this; only /admin/requests searches BoardGameGeek to add new games.
import { Badge } from './ui/badge';
import { Button } from './ui/button';
import { Card, CardContent } from './ui/card';
import { Input } from './ui/input';
interface Props { action: string; q: string; results: { slug: string; name: string; sourceCount?: number }[] | null; hrefFor?: (slug: string) => string; label?: string }
const { action, q, results, hrefFor = (slug: string) => `/admin/games/${encodeURIComponent(slug)}`, label = 'Find a game in Rogue' } = Astro.props;
---
<Card className="mb-3 text-base"><CardContent>
  <form method="get" action={action} class="flex flex-wrap gap-2" role="search">
    <Input name="q" type="search" defaultValue={q} aria-label={label} placeholder={label} required minLength={1} maxLength={80} className="flex-1 bg-background" />
    <Button type="submit">Search</Button>
  </form>
  {results && results.length > 0 && (
    <ul class="mt-3 mb-0 list-none p-0">
      {results.map((g) => <li class="border-t border-border py-1.5"><a href={hrefFor(g.slug)}><b>{g.name}</b></a> <small><code>{g.slug}</code></small>{g.sourceCount === 0 && <> <Badge variant="secondary">no sources</Badge></>}</li>)}
    </ul>
  )}
  {results && results.length === 0 && <p class="mt-3 mb-0" role="status">No game in Rogue matches “{q}” (the search covers every game, with or without sources). New games from BoardGameGeek are added only on <a href="/admin/requests">Game requests</a>.</p>}
</CardContent></Card>
