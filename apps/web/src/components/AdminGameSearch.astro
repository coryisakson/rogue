---
// Admin title search (same pick list as /request-game, via adminGameSearch in lib/game-sources.ts). A result already in Rogue
// links to its game page (/admin/games/<slug>); any other result can start an admin-approved request (POST handled by /admin/requests).
// No BGG match (or search off): the note says why, and "Add by name" starts the same approved request without a BGG id.
import type { AdminMatch } from '../lib/game-sources';
import { Button, buttonVariants } from './ui/button';
import { Card, CardContent } from './ui/card';
import { Input } from './ui/input';
interface Props { action: string; q: string; matches: AdminMatch[] | null; error: string | null; note?: string | null; searchOn: boolean }
const { action, q, matches, error, note = null, searchOn } = Astro.props;
const showByName = !searchOn || error !== null || (matches !== null && matches.length === 0);
---
<Card className="mb-3 text-base"><CardContent>
  {searchOn ? (
    <>
      <form method="get" action={action} class="flex flex-wrap gap-2">
        <Input name="q" defaultValue={q} aria-label="Find a game by name" placeholder="Find a game by name" required minLength={2} maxLength={80} className="flex-1 bg-background" />
        <Button type="submit">Search</Button>
      </form>
      {error && <p class="mb-0" role="status">{error}</p>}
      {matches && matches.length > 0 && (
        <ul class="mt-3 mb-0 list-none p-0">
          {matches.map((m) => (
            <li class="flex flex-wrap items-center gap-2.5 border-t border-border py-1.5">
              <span class="flex-1"><b>{m.title}</b>{m.year && <> ({m.year})</>} · <a href={m.url} rel="noopener nofollow" target="_blank">BoardGameGeek</a></span>
              {m.inRogue ? (
                <a data-slot="button" class={buttonVariants({ variant: 'secondary' })} href={`/admin/games/${encodeURIComponent(m.inRogue)}`}>In Rogue: open game</a>
              ) : (
                <form method="post" action="/admin/requests">
                  <input type="hidden" name="action" value="request-game" /><input type="hidden" name="bggId" value={m.bggId} /><input type="hidden" name="title" value={m.title} /><input type="hidden" name="year" value={m.year ?? ''} />
                  <Button type="submit" variant="outline">Request (approved; Scout + rights checks run)</Button>
                </form>
              )}
            </li>
          ))}
        </ul>
      )}
      {matches && matches.length === 0 && !error && <p class="mb-0" role="status">{note ?? `No match found for “${q}”.`}</p>}
    </>
  ) : <p class="m-0">Title search is off (ROGUE_SEARCH_BASE_URL is not set).</p>}
  {showByName && (
    <form method="post" action="/admin/requests" class="mt-3 flex flex-wrap items-end gap-2" data-add-by-name>
      <input type="hidden" name="action" value="request-name" />
      <label class="grid flex-1 gap-1">Add by name (no BoardGameGeek page) <Input name="title" defaultValue={q} required minLength={2} maxLength={80} className="bg-background" /></label>
      <label class="grid w-24 gap-1">Year <Input name="year" inputMode="numeric" pattern="[0-9]{4}" maxLength={4} className="bg-background" /></label>
      <Button type="submit" variant="outline">Request by name (approved; Scout + rights checks run)</Button>
    </form>
  )}
</CardContent></Card>
