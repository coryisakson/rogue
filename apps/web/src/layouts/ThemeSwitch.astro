---
// Colour theme switch (Auto/Light/Dark) for the footer: the React island components/ThemeToggle.tsx (shadcn DropdownMenu).
// It needs JavaScript (the choice lives in localStorage), so nothing shows without it.
import { t, type Locale } from '@rogue/core';
import ThemeToggle from '../components/ThemeToggle';
interface Props { locale: Locale }
const { locale } = Astro.props;
const labels = { label: t(locale, 'theme.label'), auto: t(locale, 'theme.auto'), light: t(locale, 'theme.light'), dark: t(locale, 'theme.dark') };
---
<ThemeToggle client:idle labels={labels} />
