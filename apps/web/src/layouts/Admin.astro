---
import Base from './Base.astro';
interface Props { title: string }
const { title } = Astro.props;
// Access is enforced in middleware.ts (a layout cannot return a redirect).
const tabs = [['/admin', 'Overview'], ['/admin/backups', 'Backups'], ['/admin/approvals', 'Approvals'], ['/admin/review-log', 'Review log'], ['/admin/users', 'Users'], ['/admin/design', 'Design']];
---
<Base title={`Admin: ${title}`}>
  <main>
    <h1>Admin · {title}</h1>
    <p>{tabs.map(([href, label]) => <a href={href} style="margin-right:1rem">{label}</a>)}</p>
    <slot />
  </main>
</Base>
