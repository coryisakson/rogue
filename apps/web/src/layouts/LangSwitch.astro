---
// Language switcher shown on every page: a plain form POST to /account/language, so it works without JavaScript.
import { LANGUAGE_NAMES, LOCALES, t, type Locale } from '@rogue/core';
interface Props { locale: Locale; id: string }
const { locale, id } = Astro.props;
const here = Astro.url.pathname + Astro.url.search;
---
<form method="post" action="/account/language" class="lang-switch">
  <input type="hidden" name="next" value={here} />
  <label for={id}>{t(locale, 'lang.label')}</label>
  <select id={id} name="lang">{LOCALES.map((l) => <option value={l} lang={l} selected={l === locale}>{LANGUAGE_NAMES[l]}</option>)}</select>
  <button type="submit">{t(locale, 'lang.change')}</button>
</form>
